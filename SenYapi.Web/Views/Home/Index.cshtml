@model HomeIndexViewModel
@{
    ViewData["Title"] = "Anasayfa";
}

<!-- Carousel Start -->
<div id="carousel" class="carousel slide" data-ride="carousel">
    <ol class="carousel-indicators">
        <li data-target="#carousel" data-slide-to="0" class="active"></li>
        <li data-target="#carousel" data-slide-to="1"></li>
        <li data-target="#carousel" data-slide-to="2"></li>
    </ol>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/theme/builderz/img/carousel-1.jpg" alt="Carousel Image">
            <div class="carousel-caption">
                <p class="animated fadeInRight">Biz Profesyoneliz</p>
                <h1 class="animated fadeInLeft">Hayalinizdeki Projeler İçin</h1>
                <a class="btn animated fadeInUp" asp-controller="Contact" asp-action="Index">Teklif Alın</a>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/theme/builderz/img/carousel-2.jpg" alt="Carousel Image">
            <div class="carousel-caption">
                <p class="animated fadeInRight">Uzman İnşaat ve Mimarlık</p>
                <h1 class="animated fadeInLeft">Geleceği Birlikte İnşa Ediyoruz</h1>
                <a class="btn animated fadeInUp" asp-controller="Project" asp-action="Index">Projelerimizi İnceleyin</a>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/theme/builderz/img/carousel-3.jpg" alt="Carousel Image">
            <div class="carousel-caption">
                <p class="animated fadeInRight">Güven ve Kalite</p>
                <h1 class="animated fadeInLeft">Hayalinizdeki Güvenli Yaşam</h1>
                <a class="btn animated fadeInUp" asp-controller="Contact" asp-action="Index">Bize Ulaşın</a>
            </div>
        </div>
    </div>

    <a class="carousel-control-prev" href="#carousel" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="sr-only">Önceki</span>
    </a>
    <a class="carousel-control-next" href="#carousel" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="sr-only">Sonraki</span>
    </a>
</div>
<!-- Carousel End -->


<!-- Feature Start-->
<div class="feature wow fadeInUp" data-wow-delay="0.1s">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-lg-4 col-md-12">
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="flaticon-worker"></i>
                    </div>
                    <div class="feature-text">
                        <h3>Uzman Kadro</h3>
                        <p>Deneyimli mühendis, mimar ve saha ekiplerimizle yüksek standartta işçilik sunuyoruz.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-12">
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="flaticon-building"></i>
                    </div>
                    <div class="feature-text">
                        <h3>Kaliteli İşçilik</h3>
                        <p>En dayanıklı malzemeler ve ileri inşaat teknolojileri ile uzun ömürlü yapılar üretiyoruz.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-12">
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="flaticon-call"></i>
                    </div>
                    <div class="feature-text">
                        <h3>7/24 Kesintisiz Destek</h3>
                        <p>Tüm proje ve danışmanlık süreçlerinizde her an yanınızda olan profesyonel destek hattı.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Feature End-->


<!-- About Start -->
<div class="about wow fadeInUp" data-wow-delay="0.1s">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-5 col-md-6">
                <div class="about-img">
                    <img src="~/theme/builderz/img/about.jpg" alt="About Image">
                </div>
            </div>
            <div class="col-lg-7 col-md-6">
                <div class="section-header text-left">
                    <p>Şen Yapı'ya Hoş Geldiniz</p>
                    <h2>25 Yıllık İnşaat ve Mimarlık Deneyimi</h2>
                </div>
                <div class="about-text">
                    <p>
                        Çeyrek asırlık tecrübemizle konut, ticari alan ve sanayi yapıları inşaatında güven, estetik ve kaliteyi bir arada sunuyoruz. İnovatif tasarım yaklaşımlarımız ve çevreye duyarlı mühendislik çözümlerimizle sektörde öncü olmaya devam ediyoruz.
                    </p>
                    <p>
                        Her projemizde müşteri memnuniyetini en üst düzeyde tutuyor, zamanında teslim garantisiyle anahtar teslim projeler üretiyoruz.
                    </p>
                    <a class="btn" asp-controller="About" asp-action="Index">Daha Fazla Bilgi</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- About End -->


<!-- Fact Start -->
<div class="fact">
    <div class="container-fluid">
        <div class="row counters">
            <div class="col-md-6 fact-left wow slideInLeft">
                <div class="row">
                    <div class="col-6">
                        <div class="fact-icon">
                            <i class="flaticon-worker"></i>
                        </div>
                        <div class="fact-text">
                            <h2 data-toggle="counter-up">125</h2>
                            <p>Uzman Çalışan</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="fact-icon">
                            <i class="flaticon-building"></i>
                        </div>
                        <div class="fact-text">
                            <h2 data-toggle="counter-up">530</h2>
                            <p>Mutlu Müşteri</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 fact-right wow slideInRight">
                <div class="row">
                    <div class="col-6">
                        <div class="fact-icon">
                            <i class="flaticon-address"></i>
                        </div>
                        <div class="fact-text">
                            <h2 data-toggle="counter-up">840</h2>
                            <p>Tamamlanan Proje</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="fact-icon">
                            <i class="flaticon-crane"></i>
                        </div>
                        <div class="fact-text">
                            <h2 data-toggle="counter-up">45</h2>
                            <p>Devam Eden Proje</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Fact End -->


<!-- Service Start -->
<div class="service">
    <div class="container">
        <div class="section-header text-center">
            <p>Hizmetlerimiz</p>
            <h2>Neler Sunuyoruz?</h2>
        </div>
        <div class="row">
            @foreach (var s in Model.Services.Take(6))
            {
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="service-item">
                        <div class="service-img">
                            <img src="@Url.Content(s.ImageUrl)" alt="@s.Title">
                            <div class="service-overlay">
                                <p>@s.Description</p>
                            </div>
                        </div>
                        <div class="service-text">
                            <h3>@s.Title</h3>
                            <a class="btn" href="@Url.Content(s.ImageUrl)" data-lightbox="service">+</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.Services != null && Model.Services.Count() > 6)
        {
            <div class="row mt-4">
                <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.2s">
                    <a asp-controller="Service" asp-action="Index" class="btn-view-all">
                        Tüm Hizmetlerimizi Gör <i class="fa fa-angle-double-right ml-2"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>
<!-- Service End -->


<!-- Video Start -->
<div class="video wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <button type="button" class="btn-play" data-toggle="modal" data-src="https://www.youtube.com/embed/DWRcNpR6Kdc" data-target="#videoModal">
            <span></span>
        </button>
    </div>
</div>

<div class="modal fade" id="videoModal" tabindex="-1" role="dialog" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <button type="button" class="close" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>        
                <div class="embed-responsive embed-responsive-16by9">
                    <iframe class="embed-responsive-item" src="" id="video" allowscriptaccess="always" allow="autoplay"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Video End -->


<!-- Portfolio (Projeler) Start -->
<div class="portfolio">
    <div class="container">
        <div class="section-header text-center">
            <p>Projelerimiz</p>
            <h2>Öne Çıkan İnşaat Eserlerimiz</h2>
        </div>
        <div class="row portfolio-container">
            @foreach (var p in Model.Projects.Take(3))
            {
                <div class="col-lg-4 col-md-6 col-sm-12 portfolio-item wow fadeInUp" data-wow-delay="0.1s">
                    <div class="portfolio-warp">
                        <div class="portfolio-img">
                            <img src="@Url.Content(p.ImageUrl)" alt="@p.Title">
                            <div class="portfolio-overlay">
                                <p>@p.Description</p>
                            </div>
                            <a class="portfolio-zoom-btn" href="@Url.Content(p.ImageUrl)" data-lightbox="portfolio" title="Görseli Büyüt" aria-label="Görseli Büyüt">
                                <i class="fa fa-search-plus"></i>
                            </a>
                        </div>
                        <div class="portfolio-text">
                            <h3 class="portfolio-title"><a href="/projeler/@(string.IsNullOrEmpty(p.Slug) ? p.Id.ToString() : p.Slug)">@p.Title</a></h3>
                            <div class="portfolio-action mt-auto">
                                <a href="/projeler/@(string.IsNullOrEmpty(p.Slug) ? p.Id.ToString() : p.Slug)" class="project-detail-link">
                                    Projeyi İncele <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.Projects != null && Model.Projects.Count() > 3)
        {
            <div class="row mt-4">
                <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.2s">
                    <a asp-controller="Project" asp-action="Index" class="btn-view-all">
                        Tüm Projeleri Gör <i class="fa fa-angle-double-right ml-2"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>
<!-- Portfolio (Projeler) End -->


<!-- Team Start -->
<div class="team">
    <div class="container">
        <div class="section-header text-center">
            <p>Ekibimiz</p>
            <h2>Uzman Mühendislerimiz</h2>
        </div>
        <div class="row">
            @foreach (var member in Model.TeamMembers.Take(4))
            {
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="team-item">
                        <div class="team-img">
                            <img src="@Url.Content(member.ImageUrl)" alt="@member.FullName">
                        </div>
                        <div class="team-text">
                            <h2>@member.FullName</h2>
                            <p>@member.Designation</p>
                        </div>
                        <div class="team-social">
                            @if (!string.IsNullOrEmpty(member.TwitterUrl))
                            {
                                <a class="social-tw" href="@member.TwitterUrl" target="_blank"><i class="fab fa-twitter"></i></a>
                            }
                            @if (!string.IsNullOrEmpty(member.FacebookUrl))
                            {
                                <a class="social-fb" href="@member.FacebookUrl" target="_blank"><i class="fab fa-facebook-f"></i></a>
                            }
                            @if (!string.IsNullOrEmpty(member.LinkedInUrl))
                            {
                                <a class="social-li" href="@member.LinkedInUrl" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                            }
                            @if (!string.IsNullOrEmpty(member.InstagramUrl))
                            {
                                <a class="social-in" href="@member.InstagramUrl" target="_blank"><i class="fab fa-instagram"></i></a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.TeamMembers != null && Model.TeamMembers.Count() > 4)
        {
            <div class="row mt-4">
                <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.2s">
                    <a asp-controller="Team" asp-action="Index" class="btn-view-all">
                        Tüm Ekibimizi Gör <i class="fa fa-angle-double-right ml-2"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>
<!-- Team End -->


<!-- FAQs Start -->
<div class="faqs">
    <div class="container">
        <div class="section-header text-center">
            <p>Sıkça Sorulan Sorular</p>
            <h2>Merak Edilenler</h2>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div id="accordion-1">
                    <div class="card wow fadeInLeft" data-wow-delay="0.1s">
                        <div class="card-header">
                            <a class="card-link collapsed" data-toggle="collapse" href="#collapseOne">
                                Proje teslim süreleriniz nasıl belirleniyor?
                            </a>
                        </div>
                        <div id="collapseOne" class="collapse" data-parent="#accordion-1">
                            <div class="card-body">
                                Projenin kapsamına, zemin koşullarına ve mimari gereksinimlerine göre detaylı bir iş planı hazırlanarak sözleşmeli kesin teslim tarihi belirlenir.
                            </div>
                        </div>
                    </div>
                    <div class="card wow fadeInLeft" data-wow-delay="0.2s">
                        <div class="card-header">
                            <a class="card-link collapsed" data-toggle="collapse" href="#collapseTwo">
                                İnşaat malzemelerinde kalite standartlarınız nelerdir?
                            </a>
                        </div>
                        <div id="collapseTwo" class="collapse" data-parent="#accordion-1">
                            <div class="card-body">
                                Yalnızca TSE, CE ve uluslararası kalite sertifikalarına sahip birinci sınıf yapı malzemeleri ve depreme dayanıklı çelik-beton sistemleri kullanıyoruz.
                            </div>
                        </div>
                    </div>
                    <div class="card wow fadeInLeft" data-wow-delay="0.3s">
                        <div class="card-header">
                            <a class="card-link collapsed" data-toggle="collapse" href="#collapseThree">
                                Kentsel dönüşüm projelerinde destek sağlıyor musunuz?
                            </a>
                        </div>
                        <div id="collapseThree" class="collapse" data-parent="#accordion-1">
                            <div class="card-body">
                                Evet, risk tespiti, hukuki süreçler ve anahtar teslim yenileme aşamalarının tamamında kapsamlı danışmanlık ve müteahhitlik hizmeti sunuyoruz.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div id="accordion-2">
                    <div class="card wow fadeInRight" data-wow-delay="0.1s">
                        <div class="card-header">
                            <a class="card-link collapsed" data-toggle="collapse" href="#collapseFour">
                                Fiyat teklifi alma süreci nasıl işler?
                            </a>
                        </div>
                        <div id="collapseFour" class="collapse" data-parent="#accordion-2">
                            <div class="card-body">
                                Web sitemizdeki iletişim formu veya telefon numaramız üzerinden bize ulaştığınızda uzman ekibimiz ücretsiz keşif ve maliyet analizi gerçekleştirir.
                            </div>
                        </div>
                    </div>
                    <div class="card wow fadeInRight" data-wow-delay="0.2s">
                        <div class="card-header">
                            <a class="card-link collapsed" data-toggle="collapse" href="#collapseFive">
                                Tamamlanan projelere garanti veriyor musunuz?
                            </a>
                        </div>
                        <div id="collapseFive" class="collapse" data-parent="#accordion-2">
                            <div class="card-body">
                                İnşaat ve taahhüt işlerimizde yasal garanti sürelerinin yanı sıra satış sonrası teknik destek ve bakım teminatı veriyoruz.
                            </div>
                        </div>
                    </div>
                    <div class="card wow fadeInRight" data-wow-delay="0.3s">
                        <div class="card-header">
                            <a class="card-link collapsed" data-toggle="collapse" href="#collapseSix">
                                Proje aşamasında 3D görselleştirme yapılıyor mu?
                            </a>
                        </div>
                        <div id="collapseSix" class="collapse" data-parent="#accordion-2">
                            <div class="card-body">
                                Mimari ekibimiz inşaata başlamadan önce mekanlarınızın fotogerçekçi 3D renderlarını hazırlayarak onayınıza sunar.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- FAQs End -->


<!-- Testimonial Start -->
<div class="testimonial wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="testimonial-slider-nav">
                    @foreach (var t in Model.Testimonials)
                    {
                        <div class="slider-nav"><img src="@Url.Content(t.ImageUrl)" alt="@t.ClientName"></div>
                    }
                    @foreach (var t in Model.Testimonials)
                    {
                        <div class="slider-nav"><img src="@Url.Content(t.ImageUrl)" alt="@t.ClientName"></div>
                    }
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="testimonial-slider">
                    @foreach (var t in Model.Testimonials)
                    {
                        <div class="slider-item">
                            <h3>@t.ClientName</h3>
                            <h4>@t.Profession</h4>
                            <p>@t.Comment</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Testimonial End -->


<!-- Blog Start -->
<div class="blog">
    <div class="container">
        <div class="section-header text-center">
            <p>Son Haberler</p>
            <h2>Blogumuzdan Yazılar</h2>
        </div>
        <div class="row">
            @foreach (var post in Model.BlogPosts.Take(3))
            {
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="@Url.Content(post.ImageUrl)" alt="@post.Title">
                        </div>
                        <div class="blog-content">
                            <div class="blog-meta">
                                @if (!string.IsNullOrEmpty(post.Category))
                                {
                                    <span class="blog-meta-item blog-meta-category">
                                        <i class="fa fa-tag text-warning mr-1"></i>@post.Category
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(post.Author))
                                {
                                    <span class="blog-meta-item blog-meta-author">
                                        <i class="fa fa-user text-muted mr-1"></i>@post.Author
                                    </span>
                                }
                                <span class="blog-meta-item blog-meta-date">
                                    <i class="fa fa-calendar-alt text-muted mr-1"></i>@post.CreatedAt.ToString("dd.MM.yyyy")
                                </span>
                            </div>
                            <h3 class="blog-title">
                                <a href="/blog/@(string.IsNullOrEmpty(post.Slug) ? post.Id.ToString() : post.Slug)">@post.Title</a>
                            </h3>
                            <div class="blog-text">
                                <p>@post.Summary</p>
                            </div>
                            <div class="blog-action mt-auto">
                                <a href="/blog/@(string.IsNullOrEmpty(post.Slug) ? post.Id.ToString() : post.Slug)" class="blog-read-more">
                                    Devamını Oku <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.BlogPosts != null && Model.BlogPosts.Count() > 3)
        {
            <div class="row mt-4">
                <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.3s">
                    <a asp-controller="Blog" asp-action="Index" class="btn-view-all">
                        Tüm Blog Yazılarını Gör <i class="fa fa-angle-double-right ml-2"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>
<!-- Blog End -->
