@model BlogPost
@using System.Security.Claims
@inject ICaptchaService CaptchaService
@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Title;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var allComments = Model.Comments?.ToList() ?? new List<BlogComment>();
    var approvedTotalCount = allComments.Count(c => c.IsApproved && !c.IsDeleted);

    var rootComments = allComments
        .Where(c => c.ParentCommentId == null && 
            ((c.IsApproved && !c.IsDeleted) || 
             (c.IsDeleted && c.Replies.Any(r => r.IsApproved && !r.IsDeleted)) ||
             (!c.IsApproved && !c.IsDeleted && c.UserId == currentUserId)))
        .OrderByDescending(c => c.CreatedAt)
        .ToList();

    var pendingUserComments = User.Identity?.IsAuthenticated == true
        ? allComments.Where(c => !c.IsApproved && !c.IsDeleted && c.UserId == currentUserId && c.ParentCommentId == null).ToList()
        : new List<BlogComment>();

    var preservedComment = TempData["PreservedComment"] as string;
    var preservedName = TempData["PreservedName"] as string;
    var preservedEmail = TempData["PreservedEmail"] as string;
    var preservedWebsite = TempData["PreservedWebsite"] as string;
}

<partial name="_PageHeader" model='(Model.Title, "Blog Detayı")' />

<div class="single py-5">
    <div class="container">
        <div class="row">
            <!-- Main Article Column -->
            <div class="col-lg-8">
                <div class="single-content wow fadeInUp">
                    <div class="blog-cover-box rounded shadow-sm mb-4">
                        <img src="@Url.Content(Model.ImageUrl)" alt="@Model.Title" />
                    </div>
                    <h2 class="font-weight-bold text-dark mb-3">@Model.Title</h2>
                    <div class="text-muted mb-4 small">
                        <span><i class="fa fa-user text-warning mr-1"></i> @Model.Author</span> | 
                        <span><i class="fa fa-tag text-warning mr-1"></i> @Model.Category</span> | 
                        <span><i class="fa fa-calendar-alt text-warning mr-1"></i> @Model.CreatedAt.ToString("dd MMMM yyyy")</span> |
                        <span><i class="fa fa-eye text-warning mr-1"></i> @Model.ViewCount Görüntülenme</span>
                    </div>
                    <div class="lead text-dark mb-4" style="line-height: 1.8; word-break: break-word;">
                        @Html.Raw(Model.Content.Replace("\n", "<br/>"))
                    </div>
                </div>

                <!-- Author Bio Box -->
                <div class="single-bio wow fadeInUp mt-4 p-4 bg-light rounded border d-flex align-items-center">
                    <div class="single-bio-img mr-3">
                        <img src="~/theme/builderz/img/user.jpg" alt="Yazar" class="profile-picture rounded-circle" style="width: 70px; height: 70px; object-fit: cover;" />
                    </div>
                    <div class="single-bio-text">
                        <h5 class="font-weight-bold text-dark mb-1">@Model.Author</h5>
                        <p class="mb-0 text-muted small">
                            Şen Yapı Mühendislik & Mimari Ekibi - Sektördeki yenilikçi teknikler, kentsel dönüşüm ve modern yapı standartları hakkında makaleler hazırlamaktadır.
                        </p>
                    </div>
                </div>

                <!-- COMMENTS SECTION -->
                <div id="yorum-alani" class="wow fadeInUp mt-5 pt-3">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                        <h3 class="font-weight-bold text-dark mb-0">
                            <i class="fa fa-comments text-warning mr-2"></i> Yorumlar (@approvedTotalCount)
                        </h3>
                        <a href="#yorum-formu" class="btn btn-warning btn-sm font-weight-bold">
                            <i class="fa fa-pen mr-1"></i> Yorum Yaz
                        </a>
                    </div>

                    @if (TempData["CommentSuccess"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fa fa-check-circle mr-2"></i> @TempData["CommentSuccess"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }
                    @if (TempData["CommentError"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["CommentError"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    @if (pendingUserComments.Any())
                    {
                        <div class="alert alert-warning mb-4 shadow-sm" style="border-left: 5px solid #fdbe33;">
                            <i class="fa fa-clock mr-2 text-warning"></i>
                            <strong>Onay Bekleyen Yorumunuz:</strong> Gönderdiğiniz <strong>@pendingUserComments.Count</strong> adet ana yorum yönetici incelemesindedir. Onaylandıktan sonra herkese açık görünecektir.
                        </div>
                    }

                    <!-- Comment List Container -->
                    <div class="senyapi-comments-list">
                        @if (!rootComments.Any() && !pendingUserComments.Any())
                        {
                            <div class="text-center py-5 px-4 bg-light rounded border my-3">
                                <i class="fa fa-comment-slash fa-3x text-muted mb-3 d-block"></i>
                                <h5 class="font-weight-bold text-dark">İlk Yorumu Siz Yapın</h5>
                                <p class="text-muted small mb-3">Bu makale için henüz bir görüş bildirilmedi. Düşüncelerinizi paylaşarak tartışmaya katılabilirsiniz.</p>
                                <a href="#yorum-formu" class="btn btn-outline-dark btn-sm">Yorum Bırak</a>
                            </div>
                        }
                        else
                        {
                            var commentIndex = 0;
                            @foreach (var comment in rootComments)
                            {
                                commentIndex++;
                                var initials = string.Join("", (comment.Name ?? "K").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
                                if (initials.Length > 2) initials = initials.Substring(0, 2);
                                var isOwner = User.Identity?.IsAuthenticated == true && comment.UserId == currentUserId;
                                var isDeleted = comment.IsDeleted;
                                var replies = comment.Replies?
                                    .Where(r => (r.IsApproved && !r.IsDeleted) || (r.UserId == currentUserId && !r.IsDeleted))
                                    .OrderBy(r => r.CreatedAt)
                                    .ToList() ?? new List<BlogComment>();

                                <div class="senyapi-comment-card border rounded p-3 mb-3 bg-white shadow-sm @(commentIndex > 8 ? "d-none senyapi-extra-comment" : "")" id="comment-@comment.Id">
                                    @if (isDeleted)
                                    {
                                        <div class="p-2 mb-2 bg-light rounded text-muted small font-italic border">
                                            <i class="fa fa-info-circle mr-1 text-secondary"></i> [Bu yorum silindi]
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-start">
                                            <!-- Avatar -->
                                            <div class="senyapi-avatar mr-3 flex-shrink-0">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white font-weight-bold shadow-sm" 
                                                     style="width: 44px; height: 44px; background: #030f27; font-size: 15px; border: 2px solid #fdbe33;">
                                                    @initials
                                                </div>
                                            </div>

                                            <!-- Content -->
                                            <div class="flex-grow-1" style="min-width: 0;">
                                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-1">
                                                    <div class="mr-2">
                                                        <span class="font-weight-bold text-dark" style="font-size: 15px;">@comment.Name</span>
                                                        @if (comment.IsStaffReply || !string.IsNullOrEmpty(comment.UserRole))
                                                        {
                                                            <span class="badge badge-warning text-dark font-weight-bold ml-1 px-2 py-1" style="font-size: 11px;">
                                                                <i class="fa fa-shield-alt mr-1"></i> @(comment.UserRole ?? "Yetkili")
                                                            </span>
                                                        }
                                                        @if (isOwner)
                                                        {
                                                            <span class="badge badge-light border ml-1 text-secondary" style="font-size: 11px;">Siz</span>
                                                        }
                                                        @if (!comment.IsApproved)
                                                        {
                                                            <span class="badge badge-warning ml-1" style="font-size: 11px;">Onay Bekliyor</span>
                                                        }
                                                    </div>
                                                    <small class="text-muted" style="font-size: 12px;">
                                                        <i class="far fa-clock mr-1"></i>@comment.CreatedAt.ToString("dd MMMM yyyy, HH:mm")
                                                    </small>
                                                </div>

                                                <!-- Public Comment Text -->
                                                <div class="senyapi-comment-text text-dark my-2" style="word-break: break-word; overflow-wrap: anywhere; line-height: 1.6; font-size: 14.5px; white-space: pre-line;">
                                                    @comment.Comment
                                                </div>

                                                <!-- Legacy Admin Reply if exists -->
                                                @if (!string.IsNullOrEmpty(comment.AdminReply))
                                                {
                                                    <div class="senyapi-admin-reply p-3 rounded mt-2 mb-2 border" style="background: #fffdf5; border-left: 4px solid #fdbe33 !important;">
                                                        <div class="d-flex align-items-center mb-1">
                                                            <span class="badge badge-dark text-warning font-weight-bold mr-2 px-2 py-1" style="font-size: 11px;">
                                                                <i class="fa fa-shield-alt mr-1"></i> Şen Yapı
                                                            </span>
                                                            <small class="text-muted" style="font-size: 11px;">
                                                                @(comment.AdminReplyAt?.ToString("dd MMMM yyyy, HH:mm") ?? "Yönetici Yanıtı")
                                                            </small>
                                                        </div>
                                                        <div class="text-dark small mt-1" style="word-break: break-word; overflow-wrap: anywhere; line-height: 1.5; white-space: pre-line;">
                                                            @comment.AdminReply
                                                        </div>
                                                    </div>
                                                }

                                                <!-- Actions: Reply + Edit/Delete for Owner -->
                                                <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                                    <div>
                                                        <button class="btn btn-sm btn-link text-warning p-0 font-weight-bold" type="button" data-toggle="collapse" data-target="#replyBox-@comment.Id">
                                                            <i class="fa fa-reply mr-1"></i> Yanıtla
                                                        </button>
                                                    </div>
                                                    @if (isOwner)
                                                    {
                                                        <div class="d-flex align-items-center" style="gap: 12px;">
                                                            <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-toggle="collapse" data-target="#editBox-@comment.Id">
                                                                <i class="fa fa-edit mr-1"></i> Düzenle
                                                            </button>
                                                            <form asp-controller="Blog" asp-action="DeleteMyComment" method="post" class="d-inline m-0" onsubmit="return confirm('Yorumunuzu silmek istediğinize emin misiniz?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="commentId" value="@comment.Id" />
                                                                <input type="hidden" name="returnSlug" value="@Model.Slug" />
                                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0">
                                                                    <i class="fa fa-trash mr-1"></i> Sil
                                                                </button>
                                                            </form>
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Inline Edit Box -->
                                                @if (isOwner)
                                                {
                                                    <div class="collapse mt-2" id="editBox-@comment.Id">
                                                        <div class="p-3 bg-light rounded border">
                                                            <form asp-controller="Blog" asp-action="EditMyComment" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="commentId" value="@comment.Id" />
                                                                <input type="hidden" name="returnSlug" value="@Model.Slug" />
                                                                <div class="form-group mb-2">
                                                                    <label class="font-weight-bold small text-dark">Yorumunuzu Güncelleyin:</label>
                                                                    <textarea name="updatedComment" class="form-control" rows="3" required>@comment.Comment</textarea>
                                                                </div>
                                                                <div class="text-right">
                                                                    <button type="button" class="btn btn-secondary btn-sm" data-toggle="collapse" data-target="#editBox-@comment.Id">İptal</button>
                                                                    <button type="submit" class="btn btn-warning btn-sm font-weight-bold">Kaydet ve Onaya Gönder</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                }

                                                <!-- Inline Reply Box -->
                                                <div class="collapse mt-3" id="replyBox-@comment.Id">
                                                    <div class="p-3 bg-light rounded border" style="border-left: 3px solid #fdbe33 !important;">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <span class="small font-weight-bold text-dark">
                                                                <i class="fa fa-reply text-warning mr-1"></i> <strong>@comment.Name</strong> kullanıcısına yanıt veriyorsunuz:
                                                            </span>
                                                            <button type="button" class="btn btn-link btn-sm text-secondary p-0" data-toggle="collapse" data-target="#replyBox-@comment.Id">
                                                                <i class="fa fa-times mr-1"></i> Vazgeç
                                                            </button>
                                                        </div>
                                                        <form asp-controller="Blog" asp-action="AddComment" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="blogPostId" value="@Model.Id" />
                                                            <input type="hidden" name="returnSlug" value="@Model.Slug" />
                                                            <input type="hidden" name="parentCommentId" value="@comment.Id" />

                                                            @if (User.Identity?.IsAuthenticated != true)
                                                            {
                                                                <div class="row">
                                                                    <div class="col-md-6 form-group mb-2">
                                                                        <input type="text" class="form-control form-control-sm" name="name" required placeholder="Adınız Soyadınız *" maxlength="100" />
                                                                    </div>
                                                                    <div class="col-md-6 form-group mb-2">
                                                                        <input type="email" class="form-control form-control-sm" name="email" required placeholder="E-posta Adresiniz *" maxlength="150" />
                                                                    </div>
                                                                </div>
                                                            }
                                                            <div class="form-group mb-2">
                                                                <textarea name="comment" class="form-control form-control-sm" rows="3" required placeholder="Yanıtınızı buraya yazın..." maxlength="2000"></textarea>
                                                            </div>
                                                            <!-- CAPTCHA for reply form -->
                                                            <div class="form-group mb-2 text-left">
                                                                <div class="cf-turnstile" data-sitekey="@CaptchaService.GetSiteKey()" data-action="blog_reply" data-theme="light" data-size="compact"></div>
                                                            </div>
                                                            <div class="text-right">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-toggle="collapse" data-target="#replyBox-@comment.Id">Vazgeç</button>
                                                                <button type="submit" class="btn btn-warning btn-sm font-weight-bold">Yanıtı Gönder</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Threaded Child Replies -->
                                    @if (replies.Any())
                                    {
                                        <div class="senyapi-replies-thread ml-2 ml-md-4 mt-3 pt-2" style="border-left: 2px solid #e2e8f0; padding-left: 14px;">
                                            @foreach (var reply in replies)
                                            {
                                                var replyInitials = string.Join("", (reply.Name ?? "K").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
                                                if (replyInitials.Length > 2) replyInitials = replyInitials.Substring(0, 2);
                                                var isReplyOwner = User.Identity?.IsAuthenticated == true && reply.UserId == currentUserId;

                                                <div class="senyapi-reply-card mb-2 p-3 bg-light rounded border shadow-none" id="comment-@reply.Id">
                                                    <div class="d-flex align-items-start">
                                                        <div class="senyapi-avatar mr-2 flex-shrink-0">
                                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white font-weight-bold shadow-sm"
                                                                 style="width: 36px; height: 36px; background: #030f27; font-size: 13px; border: 2px solid #fdbe33;">
                                                                @replyInitials
                                                            </div>
                                                        </div>
                                                        <div class="flex-grow-1" style="min-width: 0;">
                                                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-1">
                                                                <div class="mr-2">
                                                                    <span class="font-weight-bold text-dark" style="font-size: 14px;">@reply.Name</span>
                                                                    @if (reply.IsStaffReply || !string.IsNullOrEmpty(reply.UserRole))
                                                                    {
                                                                        <span class="badge badge-warning text-dark font-weight-bold ml-1 px-2 py-1" style="font-size: 11px;">
                                                                            <i class="fa fa-shield-alt mr-1"></i> @(reply.UserRole ?? "Yetkili")
                                                                        </span>
                                                                    }
                                                                    @if (isReplyOwner)
                                                                    {
                                                                        <span class="badge badge-light border ml-1 text-secondary" style="font-size: 11px;">Siz</span>
                                                                    }
                                                                    @if (!reply.IsApproved)
                                                                    {
                                                                        <span class="badge badge-warning ml-1" style="font-size: 11px;">Onay Bekliyor</span>
                                                                    }
                                                                </div>
                                                                <small class="text-muted" style="font-size: 12px;">
                                                                    <i class="far fa-clock mr-1"></i>@reply.CreatedAt.ToString("dd MMMM yyyy, HH:mm")
                                                                </small>
                                                            </div>
                                                            <div class="senyapi-comment-text text-dark my-1" style="word-break: break-word; overflow-wrap: anywhere; line-height: 1.5; font-size: 14px; white-space: pre-line;">
                                                                @reply.Comment
                                                            </div>

                                                            <div class="d-flex align-items-center justify-content-between mt-2 pt-1 border-top">
                                                                <button class="btn btn-sm btn-link text-warning p-0 font-weight-bold" type="button" data-toggle="collapse" data-target="#replyBox-@comment.Id">
                                                                    <i class="fa fa-reply mr-1"></i> Yanıtla
                                                                </button>
                                                                @if (isReplyOwner)
                                                                {
                                                                    <form asp-controller="Blog" asp-action="DeleteMyComment" method="post" class="d-inline m-0" onsubmit="return confirm('Yanıtınızı silmek istediğinize emin misiniz?');">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="commentId" value="@reply.Id" />
                                                                        <input type="hidden" name="returnSlug" value="@Model.Slug" />
                                                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" style="font-size: 12px;">
                                                                            <i class="fa fa-trash mr-1"></i> Sil
                                                                        </button>
                                                                    </form>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (rootComments.Count > 8)
                            {
                                <div class="text-center mt-3" id="loadMoreCommentsContainer">
                                    <button type="button" class="btn btn-outline-dark btn-sm font-weight-bold px-4" id="btnLoadMoreComments">
                                        <i class="fa fa-chevron-down mr-1"></i> Daha Fazla Yorum Göster (@(rootComments.Count - 8) yorum daha)
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- COMMENT FORM SECTION -->
                <div id="yorum-formu" class="comment-form wow fadeInUp mt-5 p-4 bg-white rounded border shadow-sm">
                    <h4 class="font-weight-bold text-dark mb-3">
                        <i class="fa fa-pen-fancy text-warning mr-2"></i> Yorum Yapın
                    </h4>
                    <p class="text-muted small mb-3">
                        Görüşleriniz bizim için değerlidir. Yorumunuz incelendikten sonra sitemizde yayımlanacaktır.
                    </p>

                    <form asp-controller="Blog" asp-action="AddComment" method="post" id="blogCommentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="blogPostId" value="@Model.Id" />
                        <input type="hidden" name="returnSlug" value="@Model.Slug" />

                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <div class="alert alert-info py-2 small mb-3">
                                <i class="fa fa-info-circle mr-1"></i> Hesabınız var mı?
                                <a href="/giris-yap" class="font-weight-bold text-dark" style="text-decoration: underline;">Giriş yaparak</a> yorumlarınızı profilinizden takip edebilir ve düzenleyebilirsiniz.
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label for="commentName" class="font-weight-bold text-dark small">Adınız Soyadınız *</label>
                                    <input type="text" class="form-control" id="commentName" name="name" required placeholder="Adınız Soyadınız" value="@preservedName" maxlength="100">
                                </div>
                                <div class="col-md-6 form-group">
                                    <label for="commentEmail" class="font-weight-bold text-dark small">E-posta Adresiniz (Asla Paylaşılmaz) *</label>
                                    <input type="email" class="form-control" id="commentEmail" name="email" required placeholder="ornek@alanadi.com" value="@preservedEmail" maxlength="150">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="commentWebsite" class="font-weight-bold text-dark small">Web Siteniz (İsteğe bağlı)</label>
                                <input type="url" class="form-control" id="commentWebsite" name="website" placeholder="https://..." value="@preservedWebsite" maxlength="200">
                            </div>
                        }
                        else
                        {
                            <div class="mb-3 p-3 bg-light rounded border text-dark d-flex align-items-center">
                                <i class="fa fa-user-check text-success fa-2x mr-3"></i>
                                <div>
                                    <div class="font-weight-bold">@User.Identity.Name olarak yorum yapıyorsunuz</div>
                                    <small class="text-muted">Profil bilgileriniz kullanılacaktır. E-posta adresiniz gizli tutulur.</small>
                                </div>
                            </div>
                        }

                        <div class="form-group mb-3">
                            <label for="commentMessage" class="font-weight-bold text-dark small">Yorumunuz *</label>
                            <textarea id="commentMessage" name="comment" rows="4" class="form-control" required placeholder="Düşüncelerinizi buraya yazın..." maxlength="2000">@preservedComment</textarea>
                            <small class="text-muted d-block text-right mt-1" id="charCounter">Maksimum 2000 karakter</small>
                        </div>

                        <!-- CAPTCHA for main comment form -->
                        <div class="form-group mb-3 text-left">
                            <div id="cf-turnstile-blog-comment" class="cf-turnstile" data-sitekey="@CaptchaService.GetSiteKey()" data-action="blog_comment" data-theme="light"></div>
                        </div>

                        <button type="submit" class="btn btn-warning font-weight-bold py-2 px-4 shadow-sm" id="btnSubmitComment">
                            <span id="btnSubmitText"><i class="fa fa-paper-plane mr-1"></i> Yorumu Gönder</span>
                            <span id="btnSubmitSpinner" class="d-none"><i class="fa fa-spinner fa-spin mr-1"></i> Gönderiliyor...</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Sidebar Column -->
            <div class="col-lg-4">
                <div class="sidebar">
                    <div class="sidebar-widget wow fadeInUp mb-4 p-4 bg-white rounded shadow-sm border">
                        <h4 class="widget-title font-weight-bold mb-3 border-bottom pb-2">Kategoriler</h4>
                        <ul class="list-unstyled mb-0">
                            <li class="py-2 border-bottom"><a href="/blog" class="text-dark"><i class="fa fa-angle-right text-warning mr-2"></i> İnşaat Teknolojileri</a></li>
                            <li class="py-2 border-bottom"><a href="/blog" class="text-dark"><i class="fa fa-angle-right text-warning mr-2"></i> Mühendislik & Tasarım</a></li>
                            <li class="py-2 border-bottom"><a href="/blog" class="text-dark"><i class="fa fa-angle-right text-warning mr-2"></i> Deprem Güvenliği</a></li>
                            <li class="py-2 border-bottom"><a href="/blog" class="text-dark"><i class="fa fa-angle-right text-warning mr-2"></i> Kentsel Dönüşüm</a></li>
                            <li class="py-2"><a href="/blog" class="text-dark"><i class="fa fa-angle-right text-warning mr-2"></i> İç Mimari & Dekorasyon</a></li>
                        </ul>
                    </div>

                    <div class="sidebar-widget wow fadeInUp p-4 bg-dark text-white rounded shadow-sm">
                        <h4 class="widget-title font-weight-bold text-warning mb-3">İletişime Geçin</h4>
                        <p class="small text-light">Projelerimiz hakkında teklif almak ve mimari kadromuzla görüşmek için bize dilediğiniz zaman ulaşabilirsiniz.</p>
                        <a href="/iletisim" class="btn btn-warning btn-block font-weight-bold py-2 mt-3">
                            <i class="fa fa-envelope mr-1"></i> Bize Ulaşın
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Double submission prevention & loading spinner
        var form = document.getElementById("blogCommentForm");
        var btn = document.getElementById("btnSubmitComment");
        var textSpan = document.getElementById("btnSubmitText");
        var spinnerSpan = document.getElementById("btnSubmitSpinner");

        if (form && btn) {
            form.addEventListener("submit", function (e) {
                if (btn.disabled) {
                    e.preventDefault();
                    return false;
                }
                btn.disabled = true;
                textSpan.classList.add("d-none");
                spinnerSpan.classList.remove("d-none");
            });
        }

        // Multiple forms: bootstrap collapse açıldığında içindeki Turnstile widget'ını hazırla
        $(document).on('shown.bs.collapse', '.collapse', function () {
            if (window.turnstile) {
                var widgetEl = $(this).find('.cf-turnstile')[0];
                if (widgetEl && !widgetEl.querySelector('iframe')) {
                    try {
                        window.turnstile.render(widgetEl);
                    } catch (e) {
                        console.error('Turnstile render hatası:', e);
                    }
                }
            }
        });

        // Load More Comments
        var btnLoadMore = document.getElementById("btnLoadMoreComments");
        if (btnLoadMore) {
            btnLoadMore.addEventListener("click", function () {
                var extraComments = document.querySelectorAll(".senyapi-extra-comment");
                extraComments.forEach(function (el) {
                    el.classList.remove("d-none");
                });
                var container = document.getElementById("loadMoreCommentsContainer");
                if (container) container.remove();
            });
        }

        // Live Char Counter
        var textarea = document.getElementById("commentMessage");
        var charCounter = document.getElementById("charCounter");
        if (textarea && charCounter) {
            textarea.addEventListener("input", function () {
                var remaining = 2000 - this.value.length;
                charCounter.textContent = remaining + " karakter kaldı";
            });
        }

        // Hata durumunda (TempData) CAPTCHA'yı sıfırla
        @if (TempData["CommentError"] != null)
        {
            <text>
            setTimeout(function () {
                if (window.turnstile) {
                    try {
                        turnstile.reset('#cf-turnstile-blog-comment');
                    } catch (e) {
                        try { turnstile.reset(); } catch (err) {}
                    }
                }
            }, 300);
            </text>
        }
    });
</script>
}
