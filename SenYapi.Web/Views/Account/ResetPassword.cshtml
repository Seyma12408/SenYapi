@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
}

<partial name="_PageHeader" model='("Yeni Şifre Belirle", "Şifre Sıfırlama")' />

<div class="auth-wrapper py-5" style="background: #f3f6f9; min-height: 550px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card border-0 shadow-lg rounded-lg overflow-hidden" style="border-radius: 12px;">
                    <div class="card-header text-center py-4 text-white" style="background: #030f27; border-bottom: 4px solid #fdbe33;">
                        <h4 class="font-weight-bold text-white mb-1">YENİ ŞİFRE BELİRLE</h4>
                        <p class="small text-muted mb-0" style="color: #b0b9c6 !important;">Lütfen yeni ve güvenli bir şifre giriniz</p>
                    </div>

                    <div class="card-body p-4 p-md-5 bg-white">
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4 py-2" role="alert">
                                <i class="fa fa-exclamation-circle mr-2"></i>
                                <div asp-validation-summary="ModelOnly" class="d-inline"></div>
                                <button type="button" class="close" data-dismiss="alert">&times;</button>
                            </div>
                        }

                        <form asp-controller="Account" asp-action="ResetPassword" method="post">
                            <input asp-for="Email" type="hidden" />
                            <input asp-for="Token" type="hidden" />

                            <div class="form-group mb-4">
                                <label asp-for="Password" class="font-weight-bold text-dark mb-1" style="font-size: 14px;">Yeni Şifre *</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0" style="color: #fdbe33;"><i class="fa fa-key"></i></span>
                                    </div>
                                    <input asp-for="Password" type="password" id="newPassword" class="form-control border-left-0 border-right-0" placeholder="En az 6 karakter" required style="height: 48px;" />
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary border-left-0" type="button" id="toggleNewPassBtn"><i class="fa fa-eye" id="toggleNewPassIcon"></i></button>
                                    </div>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small mt-1 d-block font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="ConfirmPassword" class="font-weight-bold text-dark mb-1" style="font-size: 14px;">Yeni Şifre Tekrar *</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0" style="color: #fdbe33;"><i class="fa fa-check-circle"></i></span>
                                    </div>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-left-0" placeholder="Şifrenizi tekrar giriniz" required style="height: 48px;" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block font-weight-bold"></span>
                            </div>

                            <button type="submit" class="btn btn-block py-3 font-weight-bold shadow-sm" style="background: #fdbe33; color: #030f27; font-size: 15px; border-radius: 6px;">
                                <i class="fa fa-save mr-2"></i> ŞİFREYİ GÜNCELLE
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#toggleNewPassBtn').click(function () {
                var field = $('#newPassword');
                var icon = $('#toggleNewPassIcon');
                if (field.attr('type') === 'password') {
                    field.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    field.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });
        });
    </script>
}
