@model ForgotPasswordViewModel
@inject ICaptchaService CaptchaService
@{
    ViewData["Title"] = "Şifremi Unuttum";
    var isPhone = Model.Method == "phone";
}

<partial name="_PageHeader" model='("Şifremi Unuttum", "Şifre Sıfırlama")' />

<div class="auth-wrapper py-5" style="background: #f4f6f9; min-height: 550px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card border-0 shadow-sm rounded-lg bg-white overflow-hidden" style="border-radius: 12px; border: 1px solid #e9ecef;">
                    
                    <div class="card-body p-4 p-md-5">
                        <!-- Yöntem Seçim Sekmeleri (E-Posta / Telefon) -->
                        @if (Model.Step == 1 && ViewBag.MessageSent != true)
                        {
                            <div class="d-flex mb-4 p-1 rounded-pill" style="background-color: #f1f3f6;">
                                <a asp-controller="Account" asp-action="ForgotPassword" asp-route-method="email" class="btn btn-sm flex-fill font-weight-bold rounded-pill text-center @(!isPhone ? "shadow-sm" : "text-muted")" style="@(!isPhone ? "background: #030f27; color: #fdbe33;" : "color: #555 !important;") padding: 10px 16px; border: none; text-decoration: none;">
                                    <i class="fa fa-envelope mr-1"></i> E-Posta İle
                                </a>
                                <a asp-controller="Account" asp-action="ForgotPassword" asp-route-method="phone" class="btn btn-sm flex-fill font-weight-bold rounded-pill text-center @(isPhone ? "shadow-sm" : "text-muted")" style="@(isPhone ? "background: #030f27; color: #fdbe33;" : "color: #555 !important;") padding: 10px 16px; border: none; text-decoration: none;">
                                    <i class="fa fa-mobile-alt mr-1"></i> Telefon (SMS) İle
                                </a>
                            </div>
                        }

                        <div class="text-center mb-4">
                            <h4 class="font-weight-bold mb-1" style="color: #030f27; letter-spacing: -0.3px;">Şifrenizi mi Unuttunuz?</h4>
                            <p class="text-muted small mb-0">
                                @if (isPhone)
                                {
                                    if (Model.Step == 1)
                                    {
                                        <span>Kayıtlı telefonunuza SMS ile 6 haneli doğrulama kodu iletilecektir.</span>
                                    }
                                    else if (Model.Step == 2)
                                    {
                                        <span>Lütfen telefonunuza gönderilen 6 haneli doğrulama kodunu giriniz.</span>
                                    }
                                    else
                                    {
                                        <span>Doğrulama başarılı! Lütfen yeni şifrenizi belirleyiniz.</span>
                                    }
                                }
                                else
                                {
                                    <span>Kayıtlı e-posta adresinize şifre sıfırlama bağlantısı iletilecektir.</span>
                                }
                            </p>
                        </div>

                        <!-- Hata Özeti -->
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4 py-2" role="alert">
                                <i class="fa fa-exclamation-circle mr-2"></i>
                                <div asp-validation-summary="All" class="d-inline small font-weight-bold"></div>
                                <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">&times;</button>
                            </div>
                        }

                        @if (isPhone)
                        {
                            <!-- ================= TELEFON (SMS) İLE SIFIRLAMA ================= -->
                            if (Model.Step == 1)
                            {
                                <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="phoneForgotForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Method" value="phone" />
                                    <input type="hidden" name="Step" value="1" />

                                    <div class="alert alert-info py-2 px-3 small mb-4" style="background-color: #f0f7ff; border-left: 4px solid #007bff; color: #004085;">
                                        <i class="fa fa-shield-alt mr-1"></i> Güvenliğiniz için doğrulama kodu yalnızca sistemde önceden <strong>kayıtlı ve onaylanmış</strong> cep telefonlarına gönderilir.
                                    </div>

                                    <div class="form-group mb-4">
                                        <label asp-for="PhoneNumber" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">Kayıtlı Cep Telefonu</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;">
                                                    <i class="fa fa-phone"></i>
                                                </span>
                                            </div>
                                            <input asp-for="PhoneNumber" id="inputPhoneNumber" class="form-control auth-input border-left-0" placeholder="Örn: 0532 123 45 67" style="height: 48px; font-size: 14px;" autocomplete="tel" required />
                                        </div>
                                        <small class="text-muted d-block mt-1">Örn: 0532 123 45 67 veya +90 532 123 45 67</small>
                                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block font-weight-bold"></span>
                                    </div>

                                    <!-- CAPTCHA (Turnstile) -->
                                    <div class="form-group mb-3 text-center">
                                        <div id="cf-turnstile-forgot-phone" class="cf-turnstile d-inline-block" data-sitekey="@CaptchaService.GetSiteKey()" data-action="forgot_password_phone" data-theme="light"></div>
                                    </div>

                                    <button type="submit" class="btn btn-block py-3 font-weight-bold shadow-sm" style="background: #fdbe33; color: #030f27; font-size: 15px; border-radius: 8px; border: none;">
                                        <i class="fa fa-paper-plane mr-2"></i> DOĞRULAMA KODU GÖNDER
                                    </button>
                                </form>
                            }
                            else if (Model.Step == 2)
                            {
                                <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="verifyCodeForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="Method" value="phone" />
                                    <input type="hidden" asp-for="Step" value="2" />
                                    <input type="hidden" asp-for="SessionToken" id="sessionTokenInput" />
                                    <input type="hidden" asp-for="MaskedPhone" />
                                    <input type="hidden" asp-for="PhoneNumber" />

                                    <div class="alert alert-success py-2 px-3 small mb-4" style="background-color: #edf7ed; border-left: 4px solid #28a745; color: #1e4620;">
                                        <i class="fa fa-check-circle mr-1"></i> 6 haneli doğrulama kodu <strong>@Model.MaskedPhone</strong> numaralı telefona SMS ile iletilmiştir.
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="SmsCode" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">6 Haneli Doğrulama Kodu</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;">
                                                    <i class="fa fa-key"></i>
                                                </span>
                                            </div>
                                            <input asp-for="SmsCode" id="inputSmsCode" class="form-control auth-input border-left-0 text-center font-weight-bold" maxlength="6" placeholder="••••••" style="height: 52px; font-size: 20px; letter-spacing: 6px;" autofocus autocomplete="one-time-code" required />
                                        </div>
                                        <span asp-validation-for="SmsCode" class="text-danger small mt-1 d-block font-weight-bold"></span>
                                        <small class="text-muted d-block mt-1">Kod 3 dakika boyunca geçerlidir. En fazla 3 hatalı deneme hakkı bulunur.</small>
                                    </div>

                                    <!-- Geri Sayım ve Tekrar Gönder Alanı -->
                                    <div class="d-flex justify-content-between align-items-center mb-4 p-2 rounded" style="background: #f8f9fa;">
                                        <span class="small text-muted" id="cooldownText">
                                            Kalan süre: <strong id="countdownTimer" style="color: #030f27;">60</strong> sn
                                        </span>
                                        <button type="button" id="btnResendSms" class="btn btn-sm btn-outline-secondary font-weight-bold" disabled>
                                            <i class="fa fa-redo mr-1"></i> Tekrar Kod Gönder
                                        </button>
                                    </div>
                                    <div id="resendFeedback" class="small mb-3 d-none"></div>

                                    <button type="submit" class="btn btn-block py-3 font-weight-bold shadow-sm" style="background: #fdbe33; color: #030f27; font-size: 15px; border-radius: 8px; border: none;">
                                        <i class="fa fa-check-circle mr-2"></i> KODU DOĞRULA
                                    </button>

                                    <div class="text-center mt-3">
                                        <a asp-controller="Account" asp-action="ForgotPassword" asp-route-method="phone" class="small text-muted font-weight-bold">
                                            <i class="fa fa-undo mr-1"></i> Farklı Bir Telefon Numarası Gir
                                        </a>
                                    </div>
                                </form>
                            }
                            else if (Model.Step == 3)
                            {
                                <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="newPasswordForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="Method" value="phone" />
                                    <input type="hidden" asp-for="Step" value="3" />
                                    <input type="hidden" asp-for="SessionToken" />
                                    <input type="hidden" asp-for="PhoneNumber" />
                                    <input type="hidden" asp-for="MaskedPhone" />

                                    <div class="alert alert-success py-2 px-3 small mb-4" style="background-color: #edf7ed; border-left: 4px solid #28a745; color: #1e4620;">
                                        <i class="fa fa-check-circle mr-1"></i> Telefonunuz başarıyla doğrulandı. Lütfen hesabınız için yeni şifrenizi belirleyin.
                                    </div>

                                    <!-- Yeni Şifre -->
                                    <div class="form-group mb-3">
                                        <label asp-for="NewPassword" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">Yeni Şifre</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;">
                                                    <i class="fa fa-lock"></i>
                                                </span>
                                            </div>
                                            <input asp-for="NewPassword" type="password" id="inputNewPassword" class="form-control auth-input border-left-0 border-right-0" placeholder="En az 6 karakter" style="height: 48px; font-size: 14px;" required />
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary border-left-0" type="button" id="toggleNewPasswordBtn" tabindex="-1" style="border-color: #ced4da; background: #fff; color: #6c757d;">
                                                    <i class="fa fa-eye" id="toggleNewPasswordIcon"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block font-weight-bold"></span>
                                    </div>

                                    <!-- Yeni Şifre Tekrar -->
                                    <div class="form-group mb-4">
                                        <label asp-for="ConfirmNewPassword" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">Yeni Şifre (Tekrar)</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;">
                                                    <i class="fa fa-lock"></i>
                                                </span>
                                            </div>
                                            <input asp-for="ConfirmNewPassword" type="password" id="inputConfirmPassword" class="form-control auth-input border-left-0 border-right-0" placeholder="Şifrenizi tekrar girin" style="height: 48px; font-size: 14px;" required />
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary border-left-0" type="button" id="toggleConfirmPasswordBtn" tabindex="-1" style="border-color: #ced4da; background: #fff; color: #6c757d;">
                                                    <i class="fa fa-eye" id="toggleConfirmPasswordIcon"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block font-weight-bold"></span>
                                    </div>

                                    <button type="submit" class="btn btn-block py-3 font-weight-bold shadow-sm" style="background: #fdbe33; color: #030f27; font-size: 15px; border-radius: 8px; border: none;">
                                        <i class="fa fa-check mr-2"></i> ŞİFREYİ GÜNCELLE
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            <!-- ================= E-POSTA İLE SIFIRLAMA ================= -->
                            @if (ViewBag.MessageSent == true)
                            {
                                <div class="alert alert-success shadow-sm mb-4 py-3" style="background-color: #edf7ed; border-left: 4px solid #28a745; color: #1e4620;">
                                    <h6 class="font-weight-bold mb-1"><i class="fa fa-check-circle mr-2"></i> Talep Alındı</h6>
                                    <p class="small mb-0">Eğer sistemde kayıtlı bir hesabınız varsa, şifre sıfırlama bağlantısı e-posta adresinize iletilmiştir. Lütfen gelen kutunuzu (ve spam/gereksiz klasörünü) kontrol ediniz.</p>
                                </div>
                                <div class="text-center">
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-block py-3 font-weight-bold shadow-sm" style="background: #fdbe33; color: #030f27; font-size: 15px; border-radius: 8px;">
                                        <i class="fa fa-arrow-left mr-1"></i> Giriş Ekranına Dön
                                    </a>
                                </div>
                            }
                            else
                            {
                                <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="emailForgotForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Method" value="email" />

                                    <div class="form-group mb-4">
                                        <label asp-for="Email" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">Kayıtlı E-Posta Adresiniz</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;">
                                                    <i class="fa fa-envelope"></i>
                                                </span>
                                            </div>
                                            <input asp-for="Email" type="email" class="form-control auth-input border-left-0" placeholder="ornek@alanadi.com" style="height: 48px; font-size: 14px;" required autocomplete="email" />
                                        </div>
                                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block font-weight-bold"></span>
                                    </div>

                                    <!-- CAPTCHA (Turnstile) -->
                                    <div class="form-group mb-3 text-center">
                                        <div id="cf-turnstile-forgot-email" class="cf-turnstile d-inline-block" data-sitekey="@CaptchaService.GetSiteKey()" data-action="forgot_password_email" data-theme="light"></div>
                                    </div>

                                    <button type="submit" class="btn btn-block py-3 font-weight-bold shadow-sm" style="background: #fdbe33; color: #030f27; font-size: 15px; border-radius: 8px; border: none;">
                                        <i class="fa fa-paper-plane mr-2"></i> SIFIRLAMA BAĞLANTISI GÖNDER
                                    </button>
                                </form>
                            }
                        }

                        <div class="text-center mt-4 pt-3 border-top">
                            <a asp-controller="Account" asp-action="Login" class="small font-weight-bold" style="color: #030f27; text-decoration: underline;">
                                <i class="fa fa-arrow-left mr-1"></i> Giriş Ekranına Dön
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
        $(document).ready(function () {
            // Şifre Göster / Gizle butonları
            function setupToggle(btnId, inputId, iconId) {
                $('#' + btnId).on('click', function (e) {
                    e.preventDefault();
                    var input = $('#' + inputId);
                    var icon = $('#' + iconId);
                    if (input.attr('type') === 'password') {
                        input.attr('type', 'text');
                        icon.removeClass('fa-eye').addClass('fa-eye-slash');
                    } else {
                        input.attr('type', 'password');
                        icon.removeClass('fa-eye-slash').addClass('fa-eye');
                    }
                });
            }

            setupToggle('toggleNewPasswordBtn', 'inputNewPassword', 'toggleNewPasswordIcon');
            setupToggle('toggleConfirmPasswordBtn', 'inputConfirmPassword', 'toggleConfirmPasswordIcon');

            // Geri Sayım Sayacı (SMS Kodu Yeniden Gönderme - En az 60 sn)
            var remainingSeconds = @(Model.RemainingCooldownSeconds > 0 ? Model.RemainingCooldownSeconds : 60);
            var countdownTimerSpan = $('#countdownTimer');
            var btnResend = $('#btnResendSms');
            var cooldownText = $('#cooldownText');
            var timerInterval = null;

            function startTimer(seconds) {
                remainingSeconds = seconds;
                btnResend.prop('disabled', true);
                cooldownText.show();

                if (timerInterval) clearInterval(timerInterval);

                timerInterval = setInterval(function () {
                    remainingSeconds--;
                    countdownTimerSpan.text(remainingSeconds);

                    if (remainingSeconds <= 0) {
                        clearInterval(timerInterval);
                        btnResend.prop('disabled', false);
                        cooldownText.html('<span class="text-success"><i class="fa fa-check"></i> Kodu tekrar talep edebilirsiniz.</span>');
                    }
                }, 1000);
            }

            if ($('#verifyCodeForm').length > 0) {
                startTimer(remainingSeconds);

                // Tekrar Gönder Butonu Tıklanması
                btnResend.on('click', function () {
                    var token = $('#sessionTokenInput').val();
                    var csrfToken = $('input[name="__RequestVerificationToken"]').val();
                    var feedback = $('#resendFeedback');

                    btnResend.prop('disabled', true);
                    feedback.removeClass('d-none alert-danger alert-success').addClass('alert alert-info').text('Yeni kod gönderiliyor, lütfen bekleyiniz...');

                    $.ajax({
                        url: '@Url.Action("ResendSmsCode", "Account")',
                        type: 'POST',
                        data: {
                            sessionToken: token,
                            __RequestVerificationToken: csrfToken
                        },
                        success: function (res) {
                            if (res.success) {
                                feedback.removeClass('alert-info alert-danger').addClass('alert alert-success').text(res.message);
                                startTimer(res.remainingCooldown || 60);
                            } else {
                                feedback.removeClass('alert-info alert-success').addClass('alert alert-danger').text(res.message);
                                btnResend.prop('disabled', false);
                            }
                        },
                        error: function () {
                            feedback.removeClass('alert-info alert-success').addClass('alert alert-danger').text('Sunucuyla iletişim kurulamadı. Lütfen tekrar deneyiniz.');
                            btnResend.prop('disabled', false);
                        }
                    });
                });
            }

            // Başarısız form gönderiminde CAPTCHA'yı yenile
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <text>
                setTimeout(function () {
                    if (window.turnstile) {
                        try { turnstile.reset('#cf-turnstile-forgot-phone'); } catch (e) {}
                        try { turnstile.reset('#cf-turnstile-forgot-email'); } catch (e) {}
                    }
                }, 300);
                </text>
            }
        });
    </script>
}
