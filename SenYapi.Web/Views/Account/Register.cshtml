@model RegisterViewModel
@inject ICaptchaService CaptchaService
@{
    ViewData["Title"] = "Kayıt Ol";
}

<partial name="_PageHeader" model='("Yeni Hesap Oluştur", "Kayıt Ol")' />

<div class="auth-wrapper py-5" style="background: #f4f6f9; min-height: 550px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card border-0 shadow-sm rounded-lg bg-white overflow-hidden" style="border-radius: 12px; border: 1px solid #e9ecef;">
                    
                    <div class="card-body p-4 p-md-5">
                        <!-- Üst Seçenekler (Giriş Yap / Üye Ol) -->
                        <div class="d-flex mb-4 p-1 rounded-pill" style="background-color: #f1f3f6;">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm flex-fill font-weight-bold rounded-pill text-center text-muted" style="color: #555 !important; padding: 10px 16px; border: none; text-decoration: none;">
                                Giriş Yap
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-sm flex-fill font-weight-bold rounded-pill text-center shadow-sm" style="background: #030f27; color: #fdbe33; padding: 10px 16px; border: none;">
                                Üye Ol
                            </a>
                        </div>

                        <div class="text-center mb-4">
                            <h4 class="font-weight-bold mb-1" style="color: #030f27; letter-spacing: -0.3px;">Yeni Hesap Oluşturun</h4>
                            <p class="text-muted small mb-0">Şen Yapı ayrıcalıklarından yararlanmak için hemen üye olun</p>
                        </div>

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4 py-2" role="alert">
                                <i class="fa fa-exclamation-circle mr-2"></i>
                                <div asp-validation-summary="ModelOnly" class="d-inline small font-weight-bold"></div>
                                <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">&times;</button>
                            </div>
                        }

                        <form asp-controller="Account" asp-action="Register" method="post" autocomplete="off">
                            @Html.AntiForgeryToken()

                            <div class="form-group mb-3">
                                <label asp-for="FullName" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">Ad Soyad *</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;"><i class="fa fa-id-card"></i></span>
                                    </div>
                                    <input asp-for="FullName" class="form-control border-left-0" placeholder="Örn: Ahmet Yılmaz" required style="height: 48px; font-size: 14px;" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small mt-1 d-block font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="UserName" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">Kullanıcı Adı *</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;"><i class="fa fa-user"></i></span>
                                    </div>
                                    <input asp-for="UserName" class="form-control border-left-0" placeholder="Örn: ahmetyilmaz" required style="height: 48px; font-size: 14px;" autocomplete="username" />
                                </div>
                                <span asp-validation-for="UserName" class="text-danger small mt-1 d-block font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Email" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">E-Posta Adresi *</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;"><i class="fa fa-envelope"></i></span>
                                    </div>
                                    <input asp-for="Email" type="email" class="form-control border-left-0" placeholder="ornek@alanadi.com" required style="height: 48px; font-size: 14px;" autocomplete="email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Password" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">Şifre *</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;"><i class="fa fa-key"></i></span>
                                    </div>
                                    <input asp-for="Password" type="password" id="regPassword" class="form-control border-left-0 border-right-0" placeholder="En az 6 karakter" required style="height: 48px; font-size: 14px;" autocomplete="new-password" />
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary border-left-0" type="button" id="toggleRegPasswordBtn" tabindex="-1" style="border-color: #ced4da; background: #fff; color: #6c757d;"><i class="fa fa-eye" id="toggleRegPasswordIcon"></i></button>
                                    </div>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small mt-1 d-block font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="ConfirmPassword" class="font-weight-bold text-dark mb-1" style="font-size: 13px;">Şifre Tekrar *</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0" style="color: #030f27; border-color: #ced4da;"><i class="fa fa-check-circle"></i></span>
                                    </div>
                                    <input asp-for="ConfirmPassword" type="password" id="regConfirmPassword" class="form-control border-left-0 border-right-0" placeholder="Şifrenizi tekrar girin" required style="height: 48px; font-size: 14px;" autocomplete="new-password" />
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary border-left-0" type="button" id="toggleRegConfirmPasswordBtn" tabindex="-1" style="border-color: #ced4da; background: #fff; color: #6c757d;"><i class="fa fa-eye" id="toggleRegConfirmPasswordIcon"></i></button>
                                    </div>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block font-weight-bold"></span>
                            </div>

                            <!-- CAPTCHA (Turnstile) -->
                            <div class="form-group mb-3 text-center">
                                <div id="cf-turnstile-register" class="cf-turnstile d-inline-block" data-sitekey="@CaptchaService.GetSiteKey()" data-action="register" data-theme="light"></div>
                            </div>

                            <button type="submit" class="btn btn-block py-3 font-weight-bold shadow-sm" style="background: #fdbe33; color: #030f27; font-size: 15px; border-radius: 8px; border: none; letter-spacing: 0.5px;">
                                <i class="fa fa-user-check mr-2"></i> KAYIT OL
                            </button>
                        </form>

                        <div class="text-center mt-4 pt-3 border-top">
                            <span class="text-muted small">Zaten hesabınız var mı?</span>
                            <a asp-controller="Account" asp-action="Login" class="small font-weight-bold ml-1" style="color: #030f27; text-decoration: underline;">
                                Giriş Yapın
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
        $(document).ready(function () {
            function setupToggle(btnId, inputId, iconId) {
                $('#' + btnId).click(function (e) {
                    e.preventDefault();
                    var field = $('#' + inputId);
                    var icon = $('#' + iconId);
                    if (field.attr('type') === 'password') {
                        field.attr('type', 'text');
                        icon.removeClass('fa-eye').addClass('fa-eye-slash');
                    } else {
                        field.attr('type', 'password');
                        icon.removeClass('fa-eye-slash').addClass('fa-eye');
                    }
                });
            }
            setupToggle('toggleRegPasswordBtn', 'regPassword', 'toggleRegPasswordIcon');
            setupToggle('toggleRegConfirmPasswordBtn', 'regConfirmPassword', 'toggleRegConfirmPasswordIcon');

            // Başarısız form gönderiminden sonra veya sunucu hatası döndüğünde CAPTCHA'yı yenile
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <text>
                setTimeout(function () {
                    if (window.turnstile) {
                        try {
                            turnstile.reset('#cf-turnstile-register');
                        } catch (e) {
                            try { turnstile.reset(); } catch (err) {}
                        }
                    }
                }, 300);
                </text>
            }

            // İstemci tarafı form gönderiminde hata varsa da CAPTCHA'yı sıfırla
            $('form').on('submit', function () {
                if (!$(this).valid()) {
                    if (window.turnstile) {
                        try {
                            turnstile.reset('#cf-turnstile-register');
                        } catch (e) {
                            try { turnstile.reset(); } catch (err) {}
                        }
                    }
                }
            });
        });
    </script>
}
