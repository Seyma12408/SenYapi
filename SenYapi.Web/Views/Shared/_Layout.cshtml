<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <title>@(ViewData["Title"] ?? "Şen Yapı") - Şen Yapı İnşaat</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="İnşaat, Mimarlık, Mühendislik, Şen Yapı" name="keywords">
    <meta content="Şen Yapı - Kaliteli ve Güvenilir İnşaat Hizmetleri" name="description">

    <!-- Favicon -->
    <link href="~/theme/builderz/img/favicon.ico" rel="icon">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- CSS Libraries -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="~/theme/builderz/lib/flaticon/font/flaticon.css" rel="stylesheet"> 
    <link href="~/theme/builderz/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/theme/builderz/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/theme/builderz/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="~/theme/builderz/lib/slick/slick.css" rel="stylesheet">
    <link href="~/theme/builderz/lib/slick/slick-theme.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/theme/builderz/css/style.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="wrapper">
        <partial name="_TopBar" />
        <partial name="_Navbar" />

        @RenderBody()

        <partial name="_Footer" />
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="~/theme/builderz/lib/easing/easing.min.js"></script>
    <script src="~/theme/builderz/lib/wow/wow.min.js"></script>
    <script src="~/theme/builderz/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/theme/builderz/lib/isotope/isotope.pkgd.min.js"></script>
    <script src="~/theme/builderz/lib/lightbox/js/lightbox.min.js"></script>
    <script src="~/theme/builderz/lib/waypoints/waypoints.min.js"></script>
    <script src="~/theme/builderz/lib/counterup/counterup.min.js"></script>
    <script src="~/theme/builderz/lib/slick/slick.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/theme/builderz/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
