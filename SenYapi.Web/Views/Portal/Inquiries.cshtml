@model IEnumerable<ProjectInquiry>
@{
    ViewData["Title"] = "Bilgi Taleplerim";
}

<partial name="_PageHeader" model='("Hesap Yönetimi", "Bilgi Taleplerim")' />

<div class="container py-5">
    <partial name="_PortalNav" />

    <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 text-white font-weight-bold">
                <i class="fa fa-info-circle text-warning mr-2"></i> Projelere Yaptığım Bilgi Talepleri (@Model.Count())
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-dark">
                            <tr>
                                <th>Tarih</th>
                                <th>İlgili Proje</th>
                                <th>İletişim Tercihi</th>
                                <th>Mesajınız</th>
                                <th>Durum</th>
                                <th>Yönetici Yanıtı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inq in Model)
                            {
                                <tr>
                                    <td class="small text-muted">@inq.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (inq.Project != null)
                                        {
                                            <a href="/projeler/@inq.Project.Slug" class="font-weight-bold text-dark" target="_blank">
                                                @inq.Project.Title <i class="fa fa-external-link-alt small text-muted"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Proje ID: @inq.ProjectId</span>
                                        }
                                    </td>
                                    <td><span class="badge badge-light border">@inq.PreferredContactMethod</span></td>
                                    <td style="max-width: 250px;">
                                        <div class="text-truncate small text-dark" title="@inq.Message">@inq.Message</div>
                                    </td>
                                    <td>
                                        @switch (inq.Status)
                                        {
                                            case "Yeni":
                                                <span class="badge badge-warning">İnceleniyor</span>
                                                break;
                                            case "Islemde":
                                                <span class="badge badge-primary">İşlemde</span>
                                                break;
                                            case "Tamamlandi":
                                                <span class="badge badge-success">Yanıtlandı</span>
                                                break;
                                            default:
                                                <span class="badge badge-secondary">@inq.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(inq.AdminReply))
                                        {
                                            <button type="button" class="btn btn-outline-info btn-sm" data-toggle="modal" data-target="#replyModal-@inq.Id">
                                                <i class="fa fa-eye mr-1"></i> Yanıtı Gör
                                            </button>

                                            <!-- Modal -->
                                            <div class="modal fade text-left" id="replyModal-@inq.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered" role="document">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-dark text-white">
                                                            <h5 class="modal-title text-white">
                                                                <i class="fa fa-shield-alt text-warning mr-2"></i> Şen Yapı Yanıtı
                                                            </h5>
                                                            <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p class="small text-muted mb-1"><strong>Proje:</strong> @(inq.Project?.Title ?? "-")</p>
                                                            <p class="small text-muted mb-3"><strong>Tarih:</strong> @(inq.AdminReplyAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</p>
                                                            <label class="font-weight-bold text-dark small">Talebiniz:</label>
                                                            <div class="p-2 bg-light rounded text-muted small mb-3">@inq.Message</div>
                                                            <label class="font-weight-bold text-dark small">Yönetici Açıklaması:</label>
                                                            <div class="p-3 bg-white rounded border text-dark" style="border-left: 4px solid #fdbe33 !important; white-space: pre-wrap;">@inq.AdminReply</div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Kapat</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Henüz yanıt yok</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa fa-info-circle fa-3x text-muted mb-3 d-block"></i>
                    <h5 class="font-weight-bold text-dark">Henüz Bilgi Talebiniz Bulunmuyor</h5>
                    <p class="text-muted small mb-0">Projelerimizin detay sayfalarında yer alan "Bilgi Al" butonuyla mimarlarımıza soru sorabilirsiniz.</p>
                </div>
            }
        </div>
    </div>
</div>
