@model AppUser
@{
    ViewData["Title"] = "Hesabı Kalıcı Olarak Sil";
}

<partial name="_PageHeader" model='("Hesap Yönetimi", "Hesabı Sil")' />

<div class="container py-5">
    <partial name="_PortalNav" />

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-danger shadow-sm rounded-lg overflow-hidden">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 text-white font-weight-bold">
                        <i class="fa fa-exclamation-triangle mr-2"></i> Hesabı Kalıcı Olarak Sil
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-danger">
                        <h6 class="font-weight-bold"><i class="fa fa-skull-crossbones mr-1"></i> Dikkat: Bu işlem geri alınamaz!</h6>
                        <p class="small mb-2">Hesabınızı kalıcı olarak sildiğinizde:</p>
                        <ul class="small mb-0 pl-3">
                            <li>Adınız, e-posta adresiniz, telefon numaranız ve profil fotoğrafınız kalıcı olarak silinir veya anonimleştirilir.</li>
                            <li>Daha önce yaptığınız blog yorumlarındaki kişisel bilgileriniz <strong>[Silinmiş Kullanıcı]</strong> olarak anonimleştirilir, diğer kullanıcıların okuma akışı bozulmaz.</li>
                            <li>Tüm favori projeleriniz silinir.</li>
                            <li>Bu hesapla bir daha giriş yapamazsınız.</li>
                        </ul>
                    </div>

                    <form asp-controller="Portal" asp-action="ConfirmDeleteAccount" method="post" onsubmit="return confirm('Tüm verilerinizin silineceğini onaylıyor musunuz? Bu işlem GERİ ALINAMAZ!');">
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark">İşlemi Onaylamak İçin Şifrenizi Girin *</label>
                            <input type="password" name="confirmPassword" class="form-control" required placeholder="Mevcut Şifreniz" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/hesap/profil" class="btn btn-secondary">Vazgeç</a>
                            <button type="submit" class="btn btn-danger font-weight-bold px-4">
                                <i class="fa fa-trash mr-1"></i> Hesabımı Kalıcı Olarak Sil
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
