@model Conversation
@{
    ViewData["Title"] = Model.Subject;
}

<partial name="_PageHeader" model='("Konuşma Detayı", Model.Subject)' />

<div class="container py-5">
    <partial name="_PortalNav" />

    <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0 text-white font-weight-bold">
                    <i class="fa fa-comments text-warning mr-2"></i> @Model.Subject
                </h5>
                <small class="text-muted">Başlangıç: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
            </div>
            <div>
                <a href="/hesap/mesajlar" class="btn btn-outline-light btn-sm font-weight-bold">
                    <i class="fa fa-arrow-left mr-1"></i> Tüm Mesajlar
                </a>
            </div>
        </div>

        <div class="card-body p-4 bg-light" style="min-height: 350px;">
            @if (Model.Messages != null && Model.Messages.Any())
            {
                <div class="conversation-thread">
                    @foreach (var msg in Model.Messages.OrderBy(m => m.CreatedAt))
                    {
                        var isAdmin = msg.IsAdmin;
                        <div class="d-flex mb-3 @(isAdmin ? "justify-content-start" : "justify-content-end")">
                            <div class="card border-0 shadow-sm rounded-lg" style="max-width: 80%; @(isAdmin ? "background: #ffffff; border-left: 4px solid #fdbe33 !important;" : "background: #030f27; color: #ffffff;")">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="font-weight-bold @(isAdmin ? "text-warning" : "text-light")">
                                            @(isAdmin ? "Şen Yapı Yönetimi" : msg.SenderName)
                                        </small>
                                        <small class="text-muted ml-3" style="font-size: 11px;">
                                            @msg.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                        </small>
                                    </div>
                                    <p class="mb-0 @(isAdmin ? "text-dark" : "text-white")" style="white-space: pre-wrap; word-break: break-word;">@msg.Message</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4">Henüz mesaj bulunmuyor.</p>
            }
        </div>

        <!-- Reply Form -->
        <div class="card-footer bg-white p-3 border-top">
            @if (Model.Status != "Kapatildi")
            {
                <form asp-controller="Portal" asp-action="SendConversationReply" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="conversationId" value="@Model.Id" />
                    <div class="input-group">
                        <textarea name="message" class="form-control" rows="2" placeholder="Yanıtınızı buraya yazın..." required></textarea>
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-warning font-weight-bold px-4">
                                <i class="fa fa-paper-plane mr-1"></i> Gönder
                            </button>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-secondary mb-0 text-center py-2">
                    <i class="fa fa-lock mr-1"></i> Bu konuşma sonlandırılmıştır. Yeni bir konu için lütfen yeni mesaj başlatın.
                </div>
            }
        </div>
    </div>
</div>
