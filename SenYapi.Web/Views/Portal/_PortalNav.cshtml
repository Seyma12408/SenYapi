@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var unreadCount = (int)(ViewBag.UnreadNotifications ?? 0);
}

<div class="card border-0 shadow-sm rounded-lg mb-4 bg-dark text-white p-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between">
        <div class="d-flex align-items-center mb-2 mb-md-0">
            <i class="fa fa-user-circle fa-2x text-warning mr-3"></i>
            <div>
                <h6 class="mb-0 text-white font-weight-bold">@User.Identity?.Name</h6>
                <small class="text-muted">Kullanıcı Hesap Yönetim Paneli</small>
            </div>
        </div>
        <div>
            <a href="/" class="btn btn-outline-light btn-sm mr-2">
                <i class="fa fa-home mr-1"></i> Siteye Dön
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="fa fa-sign-out-alt mr-1"></i> Çıkış
                </button>
            </form>
        </div>
    </div>
</div>

<div class="portal-nav nav nav-pills flex-column flex-sm-row bg-white p-2 rounded shadow-sm mb-4 border">
    <a href="/hesap/profil" class="nav-link py-2 px-3 mr-1 @(currentAction == "Profile" ? "active bg-warning text-dark font-weight-bold" : "text-dark")">
        <i class="fa fa-user-cog mr-1"></i> Profilim
    </a>
    <a href="/hesap/favoriler" class="nav-link py-2 px-3 mr-1 @(currentAction == "Favorites" ? "active bg-warning text-dark font-weight-bold" : "text-dark")">
        <i class="fa fa-heart mr-1"></i> Favorilerim
    </a>
    <a href="/hesap/talepler" class="nav-link py-2 px-3 mr-1 @(currentAction == "Inquiries" ? "active bg-warning text-dark font-weight-bold" : "text-dark")">
        <i class="fa fa-info-circle mr-1"></i> Bilgi Taleplerim
    </a>
    <a href="/hesap/randevular" class="nav-link py-2 px-3 mr-1 @(currentAction == "Appointments" ? "active bg-warning text-dark font-weight-bold" : "text-dark")">
        <i class="fa fa-calendar-check mr-1"></i> Randevularım
    </a>
    <a href="/hesap/mesajlar" class="nav-link py-2 px-3 mr-1 @(currentAction == "Messages" || currentAction == "ConversationDetail" ? "active bg-warning text-dark font-weight-bold" : "text-dark")">
        <i class="fa fa-comments mr-1"></i> Mesajlarım
    </a>
    <a href="/hesap/bildirimler" class="nav-link py-2 px-3 mr-1 @(currentAction == "Notifications" ? "active bg-warning text-dark font-weight-bold" : "text-dark")">
        <i class="fa fa-bell mr-1"></i> Bildirimler
        @if (unreadCount > 0)
        {
            <span class="badge badge-danger ml-1">@unreadCount</span>
        }
    </a>
    <a href="/hesap/yorumlar" class="nav-link py-2 px-3 mr-1 @(currentAction == "Comments" ? "active bg-warning text-dark font-weight-bold" : "text-dark")">
        <i class="fa fa-comment-dots mr-1"></i> Yorumlarım
    </a>
    <a href="/hesap/kapat" class="nav-link py-2 px-3 mr-1 @(currentAction == "DeactivateAccount" ? "active bg-warning text-dark font-weight-bold" : "text-muted")">
        <i class="fa fa-power-off mr-1"></i> Dondur
    </a>
    <a href="/hesap/sil" class="nav-link py-2 px-3 @(currentAction == "DeleteAccount" ? "active bg-warning text-dark font-weight-bold" : "text-danger")">
        <i class="fa fa-user-times mr-1"></i> Hesabı Sil
    </a>
</div>

@if (TempData["PortalSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-check-circle mr-2"></i> @TempData["PortalSuccess"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["PortalError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["PortalError"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
