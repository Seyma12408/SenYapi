@model IEnumerable<FavoriteProject>
@{
    ViewData["Title"] = "Favori Projelerim";
}

<partial name="_PageHeader" model='("Hesap Yönetimi", "Favori Projelerim")' />

<div class="container py-5">
    <partial name="_PortalNav" />

    <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white font-weight-bold">
                <i class="fa fa-heart text-warning mr-2"></i> Beğendiğim Projeler (@Model.Count())
            </h5>
            <a href="/projeler" class="btn btn-warning btn-sm font-weight-bold">
                <i class="fa fa-search mr-1"></i> Tüm Projeleri Keşfet
            </a>
        </div>
        <div class="card-body p-4">
            @if (Model != null && Model.Any())
            {
                <div class="row">
                    @foreach (var fav in Model)
                    {
                        var p = fav.Project;
                        if (p == null) continue;

                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 border shadow-sm rounded overflow-hidden">
                                <div class="position-relative overflow-hidden" style="aspect-ratio: 16 / 9; width: 100%; background-color: #f0f0f0;">
                                    <img src="@Url.Content(p.ImageUrl)" alt="@p.Title" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                                    <span class="badge badge-warning position-absolute" style="top: 10px; left: 10px;">@p.CategoryName</span>
                                    @if (!p.IsActive || p.IsDeleted)
                                    {
                                        <span class="badge badge-danger position-absolute" style="top: 10px; right: 10px;">Yayından Kaldırıldı</span>
                                    }
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="font-weight-bold text-dark mb-1">@p.Title</h5>
                                    @if (!string.IsNullOrEmpty(p.Location))
                                    {
                                        <small class="text-muted mb-2 d-block"><i class="fa fa-map-marker-alt text-warning mr-1"></i>@p.Location</small>
                                    }
                                    <p class="text-muted small flex-grow-1 text-truncate">@p.Description</p>
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        @if (p.IsActive && !p.IsDeleted)
                                        {
                                            <a href="/projeler/@p.Slug" class="btn btn-dark btn-sm font-weight-bold">
                                                İncele <i class="fa fa-arrow-right ml-1"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Arşivlendi</span>
                                        }
                                        <form asp-controller="Portal" asp-action="RemoveFavorite" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="projectId" value="@p.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Favorilerden Kaldır">
                                                <i class="fa fa-trash mr-1"></i> Kaldır
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="far fa-heart fa-3x text-muted mb-3 d-block"></i>
                    <h5 class="font-weight-bold text-dark">Henüz Favori Projeniz Yok</h5>
                    <p class="text-muted small mb-4">Beğendiğiniz projeleri kaydetmek için proje sayfalarındaki kalp butonunu kullanabilirsiniz.</p>
                    <a href="/projeler" class="btn btn-warning font-weight-bold px-4 py-2">Projeleri İncele</a>
                </div>
            }
        </div>
    </div>
</div>
