@model IEnumerable<TeamMember>
@{
    ViewData["Title"] = "Ekip Yönetimi";
}

@if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-check-circle mr-2"></i> @TempData["AdminSuccess"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["AdminError"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="mb-0 font-weight-bold text-dark">
                <i class="fa fa-users text-info mr-2"></i> Ekip Kadrosu (@Model.Count())
            </h5>
            <button type="button" class="btn btn-warning btn-sm font-weight-bold" data-toggle="modal" data-target="#addTeamModal">
                <i class="fa fa-plus-circle mr-1"></i> Yeni Ekip Üyesi Ekle
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th style="width: 80px;">Fotoğraf</th>
                            <th>Adı Soyadı</th>
                            <th>Ünvan / Pozisyon</th>
                            <th>LinkedIn</th>
                            <th class="text-right" style="min-width: 170px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@Url.Content(item.ImageUrl)" alt="@item.FullName" class="admin-img-square shadow-sm" style="width: 44px; height: 44px;" />
                                    </td>
                                    <td class="font-weight-bold text-dark">@item.FullName</td>
                                    <td><span class="badge badge-light border">@item.Designation</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.LinkedInUrl))
                                        {
                                            <a href="@item.LinkedInUrl" target="_blank" class="text-primary"><i class="fab fa-linkedin fa-lg"></i></a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <div class="d-inline-flex align-items-center">
                                            <button type="button" class="btn btn-outline-warning btn-sm mr-1" data-toggle="modal" data-target="#teamEditModal-@item.Id" title="Düzenle">
                                                <i class="fa fa-edit mr-1"></i> Düzenle
                                            </button>
                                            <form asp-controller="AdminManagement" asp-action="DeleteTeamMember" asp-route-id="@item.Id" method="post" class="d-inline m-0" onsubmit="return confirm('Bu ekip üyesini silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                    <i class="fa fa-trash mr-1"></i> Sil
                                                </button>
                                            </form>
                                        </div>

                                        <!-- Team Member Edit Modal -->
                                        <div class="modal fade text-left" id="teamEditModal-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-dark text-white">
                                                        <h5 class="modal-title text-white">
                                                            <i class="fa fa-edit text-warning mr-2"></i> Ekip Üyesini Düzenle
                                                        </h5>
                                                        <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                                    </div>
                                                    <form asp-controller="AdminManagement" asp-action="UpdateTeamMember" method="post" enctype="multipart/form-data">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="Id" value="@item.Id" />
                                                        <div class="modal-body">
                                                            <div class="form-group mb-3">
                                                                <label class="font-weight-bold text-dark">Ad Soyad *</label>
                                                                <input type="text" name="FullName" class="form-control" value="@item.FullName" required />
                                                            </div>
                                                            <div class="form-group mb-3">
                                                                <label class="font-weight-bold text-dark">Ünvan / Pozisyon *</label>
                                                                <input type="text" name="Designation" class="form-control" value="@item.Designation" required />
                                                            </div>
                                                            <div class="form-group mb-3">
                                                                <label class="font-weight-bold text-dark">Fotoğraf Değiştir (Bilgisayardan Yükle)</label>
                                                                <div class="d-flex align-items-center mb-2">
                                                                    <div class="mr-3 text-center">
                                                                        <img id="editTeamPreview-@item.Id" src="@Url.Content(item.ImageUrl)" alt="@item.FullName" class="admin-img-square shadow-sm border" style="width: 70px; height: 70px; object-fit: cover;" />
                                                                    </div>
                                                                    <div class="flex-grow-1">
                                                                        <input type="file" name="imageFile" class="form-control-file border p-1 rounded" accept="image/png,image/jpeg,image/webp,image/svg+xml" onchange="previewTeamEditImage(this, '@item.Id')" />
                                                                        <small class="text-muted d-block mt-1">1:1 kare/dairesel portre oranında otomatik gösterilir.</small>
                                                                    </div>
                                                                </div>
                                                                <input type="hidden" name="ImageUrl" value="@item.ImageUrl" />
                                                            </div>
                                                            <div class="form-group mb-3">
                                                                <label class="font-weight-bold text-dark">LinkedIn Profili</label>
                                                                <input type="url" name="LinkedInUrl" class="form-control" value="@item.LinkedInUrl" />
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                                                            <button type="submit" class="btn btn-warning font-weight-bold">Değişiklikleri Kaydet</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Henüz kayıtlı ekip üyesi bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<!-- Add Team Member Modal -->
<div class="modal fade" id="addTeamModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title text-white">
                    <i class="fa fa-plus-circle text-warning mr-2"></i> Yeni Ekip Üyesi Ekle
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form asp-controller="AdminManagement" asp-action="AddTeamMember" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Ad Soyad *</label>
                        <input type="text" name="FullName" class="form-control" placeholder="Örn: Burak Demir" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Ünvan / Pozisyon *</label>
                        <input type="text" name="Designation" class="form-control" placeholder="Örn: Proje Mühendisi" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Fotoğraf Yükle</label>
                        <div class="d-flex align-items-center mb-2">
                            <div class="mr-3 text-center d-none" id="addTeamPreviewBox">
                                <img id="addTeamPreviewImg" src="#" alt="Önizleme" class="admin-img-square shadow-sm border" style="width: 70px; height: 70px; object-fit: cover;" />
                            </div>
                            <div class="flex-grow-1">
                                <input type="file" name="imageFile" id="addTeamFileInput" class="form-control-file border p-1 rounded" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                                <small class="text-muted d-block mt-1">Maksimum 5MB (JPG, PNG, WEBP) - 1:1 portre oranı</small>
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">LinkedIn Profili (Opsiyonel)</label>
                        <input type="url" name="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning font-weight-bold">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewTeamEditImage(input, id) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#editTeamPreview-' + id).attr('src', e.target.result);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        $(document).ready(function () {
            $('#addTeamFileInput').on('change', function () {
                if (this.files && this.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#addTeamPreviewImg').attr('src', e.target.result);
                        $('#addTeamPreviewBox').removeClass('d-none');
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });
        });
    </script>
}
