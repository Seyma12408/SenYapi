@section Scripts {
    <script>
        $(document).ready(function () {
            // Türkçe karakterleri slug formatına dönüştürme fonksiyonu (Canlı Önizleme)
            function toSlug(text) {
                if (!text) return '';
                var trMap = {
                    'ç': 'c', 'Ç': 'c',
                    'ğ': 'g', 'Ğ': 'g',
                    'ı': 'i', 'I': 'i', 'İ': 'i',
                    'ö': 'o', 'Ö': 'o',
                    'ş': 's', 'Ş': 's',
                    'ü': 'u', 'Ü': 'u'
                };
                var str = text.replace(/[çÇğĞıIİöÖşŞüÜ]/g, function (matched) {
                    return trMap[matched] || matched;
                }).toLowerCase();

                return str.replace(/[^a-z0-9\s-]/g, '')
                          .replace(/[\s-]+/g, '-')
                          .replace(/^-+|-+$/g, '');
            }

            // Yeni Proje Modalında Canlı Slug ve Önizleme
            $('#addProjectTitle').on('input', function () {
                var manualSlug = $('#addProjectSlug').val().trim();
                if (!manualSlug) {
                    var generated = toSlug($(this).val());
                    $('#addSlugPreview').text('https://senyapi.com/projeler/' + (generated || '...'));
                }
            });

            $('#addProjectSlug').on('input', function () {
                var val = $(this).val().trim();
                var clean = toSlug(val);
                if (clean) {
                    $('#addSlugPreview').text('https://senyapi.com/projeler/' + clean);
                } else {
                    var titleVal = $('#addProjectTitle').val();
                    var gen = toSlug(titleVal);
                    $('#addSlugPreview').text('https://senyapi.com/projeler/' + (gen || '...'));
                }
            });

            // Düzenleme Modalında Canlı Slug Önizleme
            $('.slug-edit-input').on('input', function () {
                var id = $(this).data('project-id');
                var val = $(this).val().trim();
                var clean = toSlug(val);
                $('#editSlugPreview-' + id).text('https://senyapi.com/projeler/' + (clean || '...'));
            });

            // Kapak Fotoğrafı Canlı Önizleme (FileReader)
            $('.cover-image-picker').on('change', function () {
                var input = this;
                var previewId = $(input).data('preview-id');
                var containerId = $(input).data('container-id');
                var nameId = $(input).data('name-id');

                if (input.files && input.files[0]) {
                    var file = input.files[0];
                    if (file.size > 5 * 1024 * 1024) {
                        alert('Seçilen görsel 5 MB\'den büyüktür. Lütfen daha küçük bir dosya seçiniz.');
                        input.value = '';
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#' + previewId).attr('src', e.target.result);
                        $('#' + nameId).text(file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)');
                        $('#' + containerId).removeClass('d-none').addClass('d-flex');
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Yeni Proje Modalında Kapak Fotoğrafı Canlı Önizleme
            $('#addImageFile').on('change', function () {
                var input = this;
                if (input.files && input.files[0]) {
                    var file = input.files[0];
                    if (file.size > 5 * 1024 * 1024) {
                        alert('Seçilen görsel 5 MB\'den büyüktür. Lütfen daha küçük bir dosya seçiniz.');
                        input.value = '';
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#addCoverPreview').attr('src', e.target.result);
                        $('#addCoverFileName').text(file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)');
                        $('#addCoverPreviewContainer').removeClass('d-none').addClass('d-flex');
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Form Gönderimlerinde Çift Tıklamayı (Double-Submit) Önleme
            $('form.admin-project-form').on('submit', function () {
                var $btn = $(this).find('button[type="submit"].btn-submit-prevent-double');
                if ($btn.length && !$btn.prop('disabled')) {
                    $btn.prop('disabled', true);
                    $btn.html('<i class="fa fa-spinner fa-spin mr-1"></i> Kaydediliyor...');
                }
            });
        });
    </script>
}
