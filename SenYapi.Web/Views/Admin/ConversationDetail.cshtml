@model Conversation
@{
    ViewData["Title"] = $"Mesajlaşma: {Model.Subject}";
}

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle mr-1"></i> @TempData["AdminSuccess"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-triangle mr-1"></i> @TempData["AdminError"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1 font-weight-bold text-warning">
                    <i class="fa fa-comments mr-2"></i> @Model.Subject
                </h5>
                <span class="small text-light">
                    Kullanıcı: <strong>@(Model.User?.FullName ?? Model.User?.UserName)</strong> (@Model.User?.Email) • Başlatma: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </span>
            </div>
            <div>
                <a asp-action="Conversations" class="btn btn-sm btn-outline-light font-weight-bold">
                    <i class="fa fa-arrow-left mr-1"></i> Tüm Mesajlara Dön
                </a>
            </div>
        </div>

        <div class="card-body p-4 bg-light" style="min-height: 350px;">
            <div class="conversation-thread">
                @if (Model.Messages != null && Model.Messages.Any())
                {
                    foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
                    {
                        var isCurrentAdmin = msg.IsFromAdmin;
                        <div class="d-flex mb-3 @(isCurrentAdmin ? "justify-content-end" : "justify-content-start")">
                            <div class="p-3 rounded shadow-sm" style="max-width: 75%; background-color: @(isCurrentAdmin ? "#030f27" : "#ffffff"); color: @(isCurrentAdmin ? "#ffffff" : "#212529"); border: 1px solid @(isCurrentAdmin ? "#fdbe33" : "#dee2e6");">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="@(isCurrentAdmin ? "text-warning" : "text-dark")" style="font-size: 13px;">
                                        @if (isCurrentAdmin)
                                        {
                                            <i class="fa fa-shield-alt mr-1"></i> @msg.SenderName <span class="badge badge-warning text-dark ml-1">Yetkili</span>
                                        }
                                        else
                                        {
                                            <i class="fa fa-user mr-1 text-muted"></i> @msg.SenderName
                                        }
                                    </strong>
                                    <small class="@(isCurrentAdmin ? "text-light" : "text-muted") ml-3" style="font-size: 11px;">
                                        @msg.SentAt.ToString("dd.MM.yyyy HH:mm")
                                    </small>
                                </div>
                                <div style="font-size: 14px; line-height: 1.6; word-break: break-word; white-space: pre-wrap;">@msg.Message</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted">Henüz mesaj bulunmuyor.</div>
                }
            </div>
        </div>

        <div class="card-footer bg-white p-3">
            @if (Model.IsOpen)
            {
                <form asp-action="ReplyConversation" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="conversationId" value="@Model.Id" />
                    <div class="form-group mb-2">
                        <label class="font-weight-bold small text-dark">Kullanıcıya Cevabınız:</label>
                        <textarea name="message" class="form-control" rows="3" required placeholder="Mesajınızı buraya yazınız..."></textarea>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted"><i class="fa fa-bell mr-1 text-warning"></i> Gönderdiğiniz mesaj kullanıcıya sistem bildirimi olarak anında iletilir.</small>
                        <button type="submit" class="btn btn-warning font-weight-bold px-4">
                            <i class="fa fa-paper-plane mr-1"></i> Mesajı Gönder
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    <i class="fa fa-lock mr-1"></i> Bu konuşma kapatılmıştır. Yeni mesaj gönderilemez.
                </div>
            }
        </div>
    </div>

