@model SenYapi.Web.Models.UserPermissionsViewModel
@{
    ViewData["Title"] = $"{Model.User.UserName} - Yetkileri Düzenle";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="font-weight-bold text-dark mb-1">
                <i class="fa fa-user-lock text-warning mr-2"></i> Kişiye Özel Yetki Yönetimi
            </h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-0 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Yönetim</a></li>
                    <li class="breadcrumb-item"><a asp-controller="AdminUsers" asp-action="Users">Kullanıcılar</a></li>
                    <li class="breadcrumb-item active text-muted" aria-current="page">Yetkileri Düzenle</li>
                </ol>
            </nav>
        </div>
        <div>
            <a asp-controller="AdminUsers" asp-action="Users" class="btn btn-outline-secondary btn-sm font-weight-bold shadow-sm">
                <i class="fa fa-arrow-left mr-1"></i> Kullanıcı Listesine Dön
            </a>
        </div>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-check-circle mr-2"></i> @TempData["AdminSuccess"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["AdminError"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <!-- User Profile Summary Box -->
    <div class="card border-0 shadow-sm rounded-lg mb-4 bg-light">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between">
                <div class="d-flex align-items-center mb-2 mb-md-0">
                    <div class="rounded-circle bg-dark text-warning d-flex align-items-center justify-content-center font-weight-bold mr-3 shadow-sm" 
                         style="width: 52px; height: 52px; font-size: 20px; border: 2px solid #fdbe33;">
                        @Model.User.UserName?.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <h5 class="font-weight-bold text-dark mb-1">
                            @Model.User.UserName 
                            <small class="text-muted">(@(Model.User.FullName ?? "Ad Soyad Belirtilmedi"))</small>
                        </h5>
                        <div class="small text-muted">
                            <i class="fa fa-envelope mr-1"></i> @Model.User.Email
                            <span class="mx-2">•</span>
                            <span>Kayıt: @Model.User.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                    </div>
                </div>
                <div>
                    <span class="text-muted mr-2 small">Sistem Rolü:</span>
                    @if (Model.Role == "SystemAdmin")
                    {
                        <span class="badge badge-danger font-weight-bold px-3 py-2" style="font-size: 13px;">
                            <i class="fa fa-user-shield mr-1"></i> Sistem Yöneticisi (SystemAdmin)
                        </span>
                    }
                    else if (Model.Role == "Admin")
                    {
                        <span class="badge badge-warning text-dark font-weight-bold px-3 py-2" style="font-size: 13px;">
                            <i class="fa fa-crown mr-1"></i> Yönetici (Admin)
                        </span>
                    }
                    else if (Model.Role == "Editor")
                    {
                        <span class="badge badge-info font-weight-bold px-3 py-2" style="font-size: 13px;">
                            <i class="fa fa-edit mr-1"></i> Editör
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-secondary px-3 py-2" style="font-size: 13px;">
                            <i class="fa fa-user mr-1"></i> Standart Üye
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsSystemAdmin)
    {
        <div class="alert alert-info shadow-sm p-4 text-center">
            <i class="fa fa-shield-alt fa-3x text-primary mb-3"></i>
            <h4 class="font-weight-bold text-dark">Tam Yetkili Sistem Yöneticisi</h4>
            <p class="text-muted mb-0" style="max-width: 650px; margin: auto;">
                Bu kullanıcı <strong>Sistem Yöneticisi (SystemAdmin)</strong> hesabıdır. Sistem güvenliği ve mimari kurallar gereği, sistem yöneticisinin yetkileri sınırlandırılamaz, kapatılamaz veya kişiselleştirilemez. Sistem Yöneticisi tüm modüllere ve işlemlere koşulsuz erişim hakkına sahiptir.
            </p>
        </div>
    }
    else
    {
        <form asp-controller="AdminUsers" asp-action="UpdateUserPermissions" method="post" id="permissionsForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@Model.User.Id" />

            <div class="card border-0 shadow-sm rounded-lg mb-4">
                <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center border-bottom">
                    <div>
                        <h6 class="font-weight-bold text-dark mb-0">
                            <i class="fa fa-tasks text-warning mr-1"></i> Modül Bazlı İzinler
                        </h6>
                        <small class="text-muted">
                            Seçilen kutucuklar bu kullanıcının yapabileceği işlemleri belirler. İşaretlenmeyen işlemler kesinlikle engellenir.
                        </small>
                    </div>
                    <div class="mt-2 mt-sm-0">
                        <button type="button" class="btn btn-outline-dark btn-sm mr-2" id="btnSelectAll">
                            <i class="fa fa-check-double mr-1"></i> Tümünü Seç
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnDeselectAll">
                            <i class="fa fa-times mr-1"></i> Tümünü Kaldır
                        </button>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        @foreach (var category in Model.Categories)
                        {
                            <div class="col-lg-6 mb-4">
                                <div class="card h-100 border shadow-none" style="background: #fafafa;">
                                    <div class="card-header bg-white font-weight-bold text-dark border-bottom py-2 d-flex justify-content-between align-items-center">
                                        <span>
                                            <i class="fa fa-folder text-warning mr-2"></i> @category.CategoryName
                                        </span>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-secondary btn-toggle-category" style="font-size: 11px;">
                                            Grubu Değiştir
                                        </button>
                                    </div>
                                    <div class="card-body p-3">
                                        @foreach (var perm in category.Permissions)
                                        {
                                            var isChecked = Model.AssignedPermissions.Contains(perm.Key);
                                            <div class="custom-control custom-checkbox mb-3 p-2 bg-white rounded border permission-item-box" style="transition: all 0.2s ease;">
                                                <input type="checkbox" 
                                                       class="custom-control-input perm-checkbox" 
                                                       id="perm_@perm.Key.Replace(".", "_")" 
                                                       name="selectedPermissions" 
                                                       value="@perm.Key" 
                                                       data-parent="@(perm.ParentDependency ?? "")"
                                                       @(isChecked ? "checked" : "") />
                                                <label class="custom-control-label d-block text-dark font-weight-bold cursor-pointer" for="perm_@perm.Key.Replace(".", "_")">
                                                    @perm.Name
                                                    <span class="d-block small text-muted font-weight-normal mt-1" style="font-size: 12px; line-height: 1.4;">
                                                        @perm.Description
                                                    </span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
                    <a asp-controller="AdminUsers" asp-action="Users" class="btn btn-secondary">
                        <i class="fa fa-times mr-1"></i> İptal
                    </a>
                    <button type="submit" class="btn btn-warning font-weight-bold px-4 shadow-sm" id="btnSubmitPermissions">
                        <i class="fa fa-save mr-1"></i> Yetkileri Kaydet ve Uygula
                    </button>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var checkboxes = document.querySelectorAll(".perm-checkbox");
        var adminAccessCheckbox = document.getElementById("perm_Admin_Access");

        // When any permission is checked, ensure its parent dependency is also checked
        checkboxes.forEach(function (cb) {
            cb.addEventListener("change", function () {
                if (this.checked) {
                    // Check parent chain
                    var parentKey = this.getAttribute("data-parent");
                    while (parentKey) {
                        var parentCb = document.getElementById("perm_" + parentKey.replace(/\./g, "_"));
                        if (parentCb && !parentCb.checked) {
                            parentCb.checked = true;
                            parentKey = parentCb.getAttribute("data-parent");
                        } else {
                            break;
                        }
                    }
                    // Panel access is always required for any permission
                    if (adminAccessCheckbox && !adminAccessCheckbox.checked) {
                        adminAccessCheckbox.checked = true;
                    }
                } else {
                    // If Admin.Access is unchecked, uncheck all others
                    if (this === adminAccessCheckbox) {
                        checkboxes.forEach(function (otherCb) {
                            otherCb.checked = false;
                        });
                    } else {
                        // If a parent is unchecked, uncheck its children
                        var myKey = this.value;
                        checkboxes.forEach(function (childCb) {
                            if (childCb.getAttribute("data-parent") === myKey) {
                                childCb.checked = false;
                            }
                        });
                    }
                }
            });
        });

        // Select All button
        var btnSelectAll = document.getElementById("btnSelectAll");
        if (btnSelectAll) {
            btnSelectAll.addEventListener("click", function () {
                checkboxes.forEach(function (cb) {
                    cb.checked = true;
                });
            });
        }

        // Deselect All button
        var btnDeselectAll = document.getElementById("btnDeselectAll");
        if (btnDeselectAll) {
            btnDeselectAll.addEventListener("click", function () {
                checkboxes.forEach(function (cb) {
                    cb.checked = false;
                });
            });
        }

        // Category group toggle buttons
        var catToggles = document.querySelectorAll(".btn-toggle-category");
        catToggles.forEach(function (btn) {
            btn.addEventListener("click", function () {
                var card = this.closest(".card");
                var groupCheckboxes = card.querySelectorAll(".perm-checkbox");
                var anyUnchecked = Array.from(groupCheckboxes).some(function (c) { return !c.checked; });
                groupCheckboxes.forEach(function (c) {
                    c.checked = anyUnchecked;
                    c.dispatchEvent(new Event("change"));
                });
            });
        });
    });
</script>
}
