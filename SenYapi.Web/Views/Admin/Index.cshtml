@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Yönetim Paneli - Genel Bakış";
}

@if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-check-circle mr-2"></i> @TempData["AdminSuccess"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["AdminError"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm text-white" style="background: #030f27; border-left: 5px solid #fdbe33 !important; border-radius: 8px;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase font-weight-bold" style="color: #b0b9c6 !important;">Mesajlar</span>
                            <h3 class="font-weight-bold mb-0 text-warning mt-1">@Model.TotalMessages</h3>
                            <small class="text-light">(@Model.UnreadMessages Okunmamış)</small>
                        </div>
                        <i class="fa fa-envelope fa-2x text-muted opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm text-white" style="background: #030f27; border-left: 5px solid #17a2b8 !important; border-radius: 8px;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase font-weight-bold" style="color: #b0b9c6 !important;">E-Bülten</span>
                            <h3 class="font-weight-bold mb-0 text-info mt-1">@Model.TotalSubscribers</h3>
                            <small class="text-light">Aktif Abone</small>
                        </div>
                        <i class="fa fa-users fa-2x text-muted opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm text-white" style="background: #030f27; border-left: 5px solid #28a745 !important; border-radius: 8px;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase font-weight-bold" style="color: #b0b9c6 !important;">Projeler</span>
                            <h3 class="font-weight-bold mb-0 text-success mt-1">@Model.TotalProjects</h3>
                            <small class="text-light">Portfolyo</small>
                        </div>
                        <i class="fa fa-building fa-2x text-muted opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm text-white" style="background: #030f27; border-left: 5px solid #ffc107 !important; border-radius: 8px;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase font-weight-bold" style="color: #b0b9c6 !important;">Hizmetler</span>
                            <h3 class="font-weight-bold mb-0 text-warning mt-1">@Model.TotalServices</h3>
                            <small class="text-light">Faaliyet Alanı</small>
                        </div>
                        <i class="fa fa-tools fa-2x text-muted opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm text-white" style="background: #030f27; border-left: 5px solid #e83e8c !important; border-radius: 8px;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase font-weight-bold" style="color: #b0b9c6 !important;">Blog Yazıları</span>
                            <h3 class="font-weight-bold mb-0 text-light mt-1">@Model.TotalBlogPosts</h3>
                            <small class="text-light">Yayınlanan</small>
                        </div>
                        <i class="fa fa-newspaper fa-2x text-muted opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm text-white" style="background: #030f27; border-left: 5px solid #6f42c1 !important; border-radius: 8px;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase font-weight-bold" style="color: #b0b9c6 !important;">Ekip Üyeleri</span>
                            <h3 class="font-weight-bold mb-0 text-light mt-1">@Model.TotalTeamMembers</h3>
                            <small class="text-light">Mühendis & Yönetici</small>
                        </div>
                        <i class="fa fa-id-badge fa-2x text-muted opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Notification / Pending Actions Bar -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-2">
            <a asp-controller="AdminInquiries" asp-action="Inquiries" asp-route-status="Beklemede" class="text-decoration-none">
                <div class="p-3 bg-white rounded shadow-sm border-left border-warning d-flex align-items-center justify-content-between" style="border-left-width: 5px !important;">
                    <div>
                        <div class="font-weight-bold text-dark">Bekleyen Bilgi Talebi</div>
                        <small class="text-muted">Proje formlarından gelen</small>
                    </div>
                    <span class="badge badge-warning text-dark font-weight-bold px-2 py-1" style="font-size: 16px;">@Model.PendingInquiries</span>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <a asp-controller="AdminAppointments" asp-action="Appointments" asp-route-status="Beklemede" class="text-decoration-none">
                <div class="p-3 bg-white rounded shadow-sm border-left border-info d-flex align-items-center justify-content-between" style="border-left-width: 5px !important;">
                    <div>
                        <div class="font-weight-bold text-dark">Bekleyen Randevu</div>
                        <small class="text-muted">Şantiye & ofis talepleri</small>
                    </div>
                    <span class="badge badge-info text-white font-weight-bold px-2 py-1" style="font-size: 16px;">@Model.PendingAppointments</span>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <a asp-controller="AdminMessages" asp-action="Conversations" class="text-decoration-none">
                <div class="p-3 bg-white rounded shadow-sm border-left border-success d-flex align-items-center justify-content-between" style="border-left-width: 5px !important;">
                    <div>
                        <div class="font-weight-bold text-dark">Açık Kullanıcı Mesajı</div>
                        <small class="text-muted">Üye portalı mesajları</small>
                    </div>
                    <span class="badge badge-success font-weight-bold px-2 py-1" style="font-size: 16px;">@Model.OpenConversations</span>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <a asp-controller="AdminComments" asp-action="Comments" asp-route-status="pending" class="text-decoration-none">
                <div class="p-3 bg-white rounded shadow-sm border-left border-danger d-flex align-items-center justify-content-between" style="border-left-width: 5px !important;">
                    <div>
                        <div class="font-weight-bold text-dark">Bekleyen Yorum</div>
                        <small class="text-muted">Blog yorum onayları</small>
                    </div>
                    <span class="badge badge-danger font-weight-bold px-2 py-1" style="font-size: 16px;">@Model.PendingComments</span>
                </div>
            </a>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row">
        <!-- Recent Messages Column -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0 font-weight-bold text-dark">
                        <i class="fa fa-inbox text-warning mr-2"></i> Son İletişim Mesajları
                    </h5>
                    <a asp-controller="AdminMessages" asp-action="Messages" class="btn btn-sm btn-outline-dark">
                        Tümünü Gör (@Model.TotalMessages)
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Tarih</th>
                                    <th>Gönderen</th>
                                    <th>Konu</th>
                                    <th>Durum</th>
                                    <th class="text-right">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Messages.Any())
                                {
                                    foreach (var msg in Model.Messages)
                                    {
                                        <tr class="@(msg.IsRead ? "" : "table-warning font-weight-bold")">
                                            <td class="small">@msg.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <div>@msg.Name</div>
                                                <small class="text-muted">@msg.Email</small>
                                            </td>
                                            <td>
                                                <div class="text-truncate" style="max-width: 250px;" title="@msg.Subject">
                                                    @msg.Subject
                                                </div>
                                            </td>
                                            <td>
                                                @if (msg.IsRead)
                                                {
                                                    <span class="badge badge-secondary">Okundu</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">Yeni</span>
                                                }
                                            </td>
                                            <td class="text-right">
                                                <div class="d-inline-flex align-items-center">
                                                    <button type="button" class="btn btn-warning btn-sm font-weight-bold mr-1" data-toggle="modal" data-target="#msgModal-@msg.Id" title="İncele ve Cevapla">
                                                        <i class="fa fa-reply mr-1"></i> Cevapla
                                                    </button>
                                                    @if (!msg.IsRead)
                                                    {
                                                        <form asp-controller="AdminMessages" asp-action="MarkMessageRead" asp-route-id="@msg.Id" method="post" class="d-inline m-0 mr-1">
                                                            <button type="submit" class="btn btn-success btn-sm" title="Okundu Yap">
                                                                <i class="fa fa-check mr-1"></i> Okundu
                                                            </button>
                                                        </form>
                                                    }
                                                    <form asp-controller="AdminMessages" asp-action="DeleteMessage" asp-route-id="@msg.Id" method="post" class="d-inline m-0" onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                            <i class="fa fa-trash mr-1"></i> Sil
                                                        </button>
                                                    </form>
                                                </div>

                                                <!-- Message Modal -->
                                                <div class="modal fade text-left" id="msgModal-@msg.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                                                        <div class="modal-content">
                                                            <div class="modal-header bg-dark text-white">
                                                                <h5 class="modal-title text-white">
                                                                    <i class="fa fa-envelope-open mr-2 text-warning"></i> @msg.Subject
                                                                </h5>
                                                                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="row">
                                                                    <div class="col-md-6 mb-2">
                                                                        <small class="text-muted d-block">Gönderen</small>
                                                                        <strong>@msg.Name</strong>
                                                                    </div>
                                                                    <div class="col-md-6 mb-2">
                                                                        <small class="text-muted d-block">E-Posta</small>
                                                                        <a href="mailto:@msg.Email" class="text-primary font-weight-bold">@msg.Email</a>
                                                                    </div>
                                                                    <div class="col-md-6 mb-2">
                                                                        <small class="text-muted d-block">Tarih</small>
                                                                        <span>@msg.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                                                    </div>
                                                                    <div class="col-md-6 mb-2">
                                                                        <small class="text-muted d-block">Durum</small>
                                                                        @if (msg.IsReplied)
                                                                        {
                                                                            <span class="badge badge-success">Cevaplandı</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge badge-warning">Cevap Bekliyor</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <hr />
                                                                <label class="font-weight-bold text-dark">Mesaj:</label>
                                                                <div class="p-3 bg-light rounded text-dark border mb-3" style="white-space: pre-wrap;">@msg.Message</div>

                                                                @if (msg.IsReplied && !string.IsNullOrEmpty(msg.ReplyMessage))
                                                                {
                                                                    <div class="alert alert-info border-0 shadow-sm">
                                                                        <h6 class="font-weight-bold mb-1 text-dark">
                                                                            <i class="fa fa-check-circle text-success mr-1"></i> Verilen Cevap (@msg.RepliedAt?.ToString("dd.MM.yyyy HH:mm")):
                                                                        </h6>
                                                                        <p class="mb-0 text-dark" style="white-space: pre-wrap;">@msg.ReplyMessage</p>
                                                                    </div>
                                                                }

                                                                <!-- Reply Form -->
                                                                <form asp-controller="AdminMessages" asp-action="ReplyMessage" method="post" class="mt-3">
                                                                    <input type="hidden" name="id" value="@msg.Id" />
                                                                    <div class="form-group mb-2">
                                                                        <label class="font-weight-bold text-dark">
                                                                            <i class="fa fa-reply text-warning mr-1"></i> Mesaja Hızlı Cevap Ver:
                                                                        </label>
                                                                        <textarea name="replyText" class="form-control" rows="3" placeholder="Kullanıcıya gönderilecek yanıtı yazın..." required></textarea>
                                                                    </div>
                                                                    <button type="submit" class="btn btn-warning font-weight-bold btn-sm">
                                                                        <i class="fa fa-paper-plane mr-1"></i> Cevap Gönder
                                                                    </button>
                                                                </form>
                                                            </div>
                                                            <div class="modal-footer">
                                                                @if (!msg.IsRead)
                                                                {
                                                                    <form asp-controller="AdminMessages" asp-action="MarkMessageRead" asp-route-id="@msg.Id" method="post" class="d-inline mr-auto">
                                                                        <button type="submit" class="btn btn-success btn-sm">
                                                                            <i class="fa fa-check mr-1"></i> Okundu Olarak İşaretle
                                                                        </button>
                                                                    </form>
                                                                }
                                                                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Kapat</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">Gelen mesaj bulunmuyor.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Subscribers & Quick Actions -->
        <div class="col-lg-4 mb-4">
            <!-- Quick Actions Card -->
            <div class="card border-0 shadow-sm rounded-lg mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 font-weight-bold text-dark">
                        <i class="fa fa-bolt text-warning mr-2"></i> Hızlı Yönetim
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a asp-controller="AdminProjects" asp-action="Projects" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span><i class="fa fa-building text-primary mr-2"></i> Projeleri Yönet</span>
                            <span class="badge badge-primary badge-pill">@Model.TotalProjects</span>
                        </a>
                        <a asp-controller="AdminManagement" asp-action="Services" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span><i class="fa fa-tools text-warning mr-2"></i> Hizmetleri Yönet</span>
                            <span class="badge badge-warning badge-pill">@Model.TotalServices</span>
                        </a>
                        <a asp-controller="AdminBlog" asp-action="Blog" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span><i class="fa fa-newspaper text-success mr-2"></i> Blog Yazılarını Yönet</span>
                            <span class="badge badge-success badge-pill">@Model.TotalBlogPosts</span>
                        </a>
                        <a asp-controller="AdminManagement" asp-action="Team" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span><i class="fa fa-users text-info mr-2"></i> Ekip Kadrosunu Yönet</span>
                            <span class="badge badge-info badge-pill">@Model.TotalTeamMembers</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Recent Subscribers Card -->
            <div class="card border-0 shadow-sm rounded-lg">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0 font-weight-bold text-dark">
                        <i class="fa fa-paper-plane text-info mr-2"></i> Son Aboneler
                    </h5>
                    <a asp-controller="AdminMessages" asp-action="Subscribers" class="btn btn-sm btn-outline-info">
                        Tümü (@Model.TotalSubscribers)
                    </a>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (Model.Subscribers.Any())
                        {
                            foreach (var sub in Model.Subscribers)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                    <div>
                                        <div class="font-weight-bold small">@sub.Email</div>
                                        <small class="text-muted">@sub.CreatedAt.ToString("dd.MM.yyyy")</small>
                                    </div>
                                    <form asp-controller="AdminMessages" asp-action="DeleteSubscriber" asp-route-id="@sub.Id" method="post" onsubmit="return confirm('Bu aboneyi silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm text-danger" title="Kaldır">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </form>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-center text-muted py-3">Henüz abone kaydı yok.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
