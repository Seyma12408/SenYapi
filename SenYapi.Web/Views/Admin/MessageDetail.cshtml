@model ContactMessage
@{
    ViewData["Title"] = $"Mesaj Detayı - {Model.Subject}";
    var replies = Model.Replies?.OrderBy(r => r.RepliedAt).ToList() ?? new List<ContactMessageReply>();
}

<!-- Alert Bildirimleri -->
@if (TempData["AdminSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-check-circle mr-2"></i> @TempData["AdminSuccess"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">&times;</button>
    </div>
}

@if (TempData["AdminError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["AdminError"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">&times;</button>
    </div>
}

<!-- Üst Başlık & Aksiyon Barı -->
<div class="card border-0 shadow-sm rounded-lg mb-4">
    <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center">
        <div class="d-flex align-items-center mb-2 mb-md-0">
            <a href="/Admin/Messages" class="btn btn-outline-dark btn-sm mr-3 font-weight-bold">
                <i class="fa fa-arrow-left mr-1"></i> Mesajlara Dön
            </a>
            <div>
                <h5 class="mb-0 font-weight-bold text-dark">
                    @Model.Subject
                </h5>
                <span class="small text-muted">Mesaj ID: #@Model.Id</span>
            </div>
        </div>

        <!-- Durum ve Hızlı Aksiyonlar -->
        <div class="d-flex align-items-center flex-wrap">
            <div class="mr-3 mb-1">
                @if (Model.IsArchived)
                {
                    <span class="badge badge-dark px-3 py-2"><i class="fa fa-archive mr-1"></i> Arşivlendi</span>
                }
                else if (Model.IsReplied)
                {
                    <span class="badge badge-success px-3 py-2"><i class="fa fa-check-circle mr-1"></i> Yanıtlandı</span>
                }
                else if (Model.IsRead)
                {
                    <span class="badge badge-secondary px-3 py-2"><i class="fa fa-envelope-open mr-1"></i> Okundu</span>
                }
                else
                {
                    <span class="badge badge-warning text-dark px-3 py-2 font-weight-bold"><i class="fa fa-envelope mr-1"></i> Yeni</span>
                }
            </div>

            <!-- Okundu / Okunmadı -->
            @if (Model.IsRead)
            {
                <form action="/Admin/MarkMessageAsUnread/@Model.Id" method="post" class="d-inline mr-2 mb-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnAction" value="MessageDetail" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Okunmadı olarak işaretle">
                        <i class="fa fa-envelope mr-1"></i> Okunmadı Yap
                    </button>
                </form>
            }
            else
            {
                <form action="/Admin/MarkMessageAsRead/@Model.Id" method="post" class="d-inline mr-2 mb-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnAction" value="MessageDetail" />
                    <button type="submit" class="btn btn-sm btn-outline-success" title="Okundu yap">
                        <i class="fa fa-check mr-1"></i> Okundu Yap
                    </button>
                </form>
            }

            <!-- Arşivle / Arşivden Çıkar -->
            <form action="/Admin/ToggleArchiveMessage/@Model.Id" method="post" class="d-inline mr-2 mb-1">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnAction" value="MessageDetail" />
                <button type="submit" class="btn btn-sm btn-outline-info">
                    <i class="fa @(Model.IsArchived ? "fa-box-open" : "fa-archive") mr-1"></i>
                    @(Model.IsArchived ? "Arşivden Çıkar" : "Arşivle")
                </button>
            </form>

            <!-- Sil -->
            <form action="/Admin/DeleteMessage/@Model.Id" method="post" class="d-inline mb-1" onsubmit="return confirm('Bu mesajı kalıcı olarak silmek istediğinize emin misiniz?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="fa fa-trash mr-1"></i> Sil
                </button>
            </form>
        </div>
    </div>
</div>

<div class="row">
    <!-- Sol Kolon: Gelen Mesaj Bilgileri -->
    <div class="col-lg-5 col-md-12 mb-4">
        <div class="card border-0 shadow-sm rounded-lg h-100">
            <div class="card-header bg-dark text-white py-3">
                <h6 class="mb-0 font-weight-bold">
                    <i class="fa fa-user-circle text-warning mr-2"></i> Gönderen & Mesaj Bilgileri
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3 pb-2 border-bottom">
                    <small class="text-muted d-block">Gönderen Kişi</small>
                    <span class="h6 font-weight-bold text-dark">@Model.Name</span>
                </div>

                <div class="mb-3 pb-2 border-bottom">
                    <small class="text-muted d-block">E-Posta Adresi</small>
                    <a href="mailto:@Model.Email" class="text-primary font-weight-bold">
                        <i class="fa fa-envelope mr-1"></i> @Model.Email
                    </a>
                </div>

                <div class="mb-3 pb-2 border-bottom">
                    <small class="text-muted d-block">Gönderilme Tarihi</small>
                    <span class="text-dark">
                        <i class="fa fa-calendar-alt text-muted mr-1"></i> @Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")
                    </span>
                </div>

                <div class="mb-3 pb-2 border-bottom">
                    <small class="text-muted d-block">Konu</small>
                    <span class="font-weight-bold text-dark">@Model.Subject</span>
                </div>

                <div>
                    <small class="text-muted d-block mb-1">Gelen Mesaj Metni</small>
                    <div class="p-3 bg-light rounded text-dark border" style="white-space: pre-wrap; line-height: 1.6; min-height: 120px;">@Model.Message</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sağ Kolon: Önceki Yanıtlar & Yeni Yanıt Formu -->
    <div class="col-lg-7 col-md-12">
        <!-- 1. Yanıt Yaz Formu -->
        <div class="card border-0 shadow-sm rounded-lg mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="mb-0 font-weight-bold text-dark">
                    <i class="fa fa-paper-plane text-warning mr-2"></i> Yanıt Yaz ve E-Posta Gönder
                </h6>
                <span class="badge badge-light text-muted border">
                    Alıcı: @Model.Email
                </span>
            </div>
            <div class="card-body">
                <form id="replyForm" action="/Admin/ReplyMessage" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnAction" value="MessageDetail" />

                    <div class="form-group mb-3">
                        <label for="replyText" class="font-weight-bold text-dark small">
                            Yanıtınız:
                        </label>
                        <textarea id="replyText" 
                                  name="replyText" 
                                  class="form-control" 
                                  rows="5" 
                                  placeholder="Kullanıcıya iletilecek yanıt metnini buraya yazın..." 
                                  required></textarea>
                        <div class="invalid-feedback">Lütfen bir yanıt metni giriniz.</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="fa fa-info-circle mr-1 text-info"></i> Yanıtınız doğrudan <strong>@Model.Email</strong> adresine e-posta olarak gönderilecektir.
                        </small>
                        <button type="submit" id="btnSubmitReply" class="btn btn-warning font-weight-bold px-4">
                            <i class="fa fa-paper-plane mr-1"></i> Yanıtı Gönder
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- 2. Önceki Yanıtlar Zaman Çizelgesi -->
        <div class="card border-0 shadow-sm rounded-lg">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 font-weight-bold text-dark">
                    <i class="fa fa-history text-secondary mr-2"></i> Önceki Yanıtlar (@replies.Count)
                </h6>
            </div>
            <div class="card-body">
                @if (replies.Any())
                {
                    <div class="timeline">
                        @foreach (var reply in replies)
                        {
                            var isStaff = reply.IsStaffReply;
                            <div class="card border @(isStaff ? "border-warning" : "border-info") mb-3 shadow-none" style="background: @(isStaff ? "#fffdf8" : "#f0fdf4");">
                                <div class="card-header @(isStaff ? "bg-light" : "bg-info text-white") py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (isStaff)
                                        {
                                            <span class="badge badge-dark text-warning font-weight-bold mr-2 px-2 py-1">
                                                <i class="fa fa-shield-alt mr-1"></i> Yönetici Yanıtı
                                            </span>
                                            <strong>@(string.IsNullOrEmpty(reply.RepliedBy) ? "Yönetici" : reply.RepliedBy)</strong>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light text-info font-weight-bold mr-2 px-2 py-1">
                                                <i class="fa fa-user mr-1"></i> Müşteri Yanıtı
                                            </span>
                                            <strong>@(reply.SenderName ?? Model.Name)</strong>
                                        }
                                        <span class="small @(isStaff ? "text-muted" : "text-white-50") ml-2">
                                            @reply.RepliedAt.ToString("dd.MM.yyyy HH:mm")
                                        </span>
                                    </div>
                                    <div>
                                        @if (isStaff)
                                        {
                                            if (reply.IsSuccess)
                                            {
                                                <span class="badge badge-success px-2 py-1">
                                                    <i class="fa fa-check-circle mr-1"></i> E-Posta İletildi
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning text-dark font-weight-bold px-2 py-1 mr-2">
                                                    <i class="fa fa-times-circle mr-1 text-danger"></i> Gönderilemedi
                                                </span>
                                                <form action="/Admin/RetryReply/@reply.Id" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="messageId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-light btn-sm font-weight-bold" title="Bu yanıtı yeniden e-posta olarak göndermeyi dene">
                                                        <i class="fa fa-redo-alt mr-1 text-danger"></i> Tekrar Dene
                                                    </button>
                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-light text-dark px-2 py-1 font-weight-bold">
                                                <i class="fa fa-globe mr-1"></i> Web Formundan
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="card-body py-3">
                                    <p class="mb-0 text-dark" style="white-space: pre-wrap; line-height: 1.5;">@reply.ReplyText</p>

                                    @if (!reply.IsSuccess && !string.IsNullOrEmpty(reply.ErrorMessage))
                                    {
                                        <div class="mt-2 p-2 bg-light border border-danger rounded text-danger small">
                                            <strong>Hata Nedeni:</strong> @reply.ErrorMessage
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-comment-slash fa-2x mb-2 text-muted d-block"></i>
                        <span>Bu mesaja ait henüz kayıtlı bir yanıt bulunmuyor.</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('replyForm');
            var btn = document.getElementById('btnSubmitReply');
            var textarea = document.getElementById('replyText');
            var isSubmitting = false;

            if (form && btn && textarea) {
                form.addEventListener('submit', function (e) {
                    var val = textarea.value.trim();
                    if (!val) {
                        e.preventDefault();
                        textarea.classList.add('is-invalid');
                        textarea.focus();
                        return false;
                    }

                    if (isSubmitting) {
                        e.preventDefault();
                        return false;
                    }

                    isSubmitting = true;
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa fa-spinner fa-spin mr-1"></i> E-Posta Gönderiliyor...';
                });

                textarea.addEventListener('input', function () {
                    if (textarea.value.trim().length > 0) {
                        textarea.classList.remove('is-invalid');
                    }
                });
            }
        })();
    </script>
}
