@model IEnumerable<BlogComment>
@{
    ViewData["Title"] = "Blog Yorumları Yönetimi";
    var status = ViewBag.Status as string;
}

@if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-check-circle mr-2"></i> @TempData["AdminSuccess"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["AdminError"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center border-bottom">
            <h5 class="mb-0 font-weight-bold text-dark">
                <i class="fa fa-comments text-warning mr-2"></i> Gelen Yorumlar (@Model.Count())
            </h5>
            <div class="btn-group btn-group-sm mt-2 mt-sm-0">
                <a asp-action="Comments" class="btn @(string.IsNullOrEmpty(status) ? "btn-dark font-weight-bold" : "btn-outline-dark")">Tümü</a>
                <a asp-action="Comments" asp-route-status="pending" class="btn @(status == "pending" ? "btn-warning font-weight-bold" : "btn-outline-warning text-dark")">Onay Bekleyenler</a>
                <a asp-action="Comments" asp-route-status="approved" class="btn @(status == "approved" ? "btn-success font-weight-bold" : "btn-outline-success")">Yayındakiler</a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Tarih</th>
                            <th>Yazar</th>
                            <th>İlgili Blog Yazısı</th>
                            <th>Yorum İçeriği</th>
                            <th>Durum</th>
                            <th class="text-right" style="min-width: 200px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="@(!item.IsApproved ? "table-warning font-weight-bold" : "")">
                                    <td class="small">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <div>@item.Name</div>
                                        <small class="text-muted">@item.Email</small>
                                    </td>
                                    <td>
                                        <a href="/blog/@item.BlogPost?.Slug" target="_blank" class="text-dark small font-weight-bold">
                                            @item.BlogPost?.Title
                                        </a>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 300px;" title="@item.Comment">
                                            @item.Comment
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.AdminReply))
                                        {
                                            <small class="text-success d-block"><i class="fa fa-reply mr-1"></i> Yönetici Yanıtı Var</small>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsApproved)
                                        {
                                            <span class="badge badge-success px-2 py-1">Yayında</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning px-2 py-1">Onay Bekliyor</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <div class="d-inline-flex align-items-center">
                                            @if (!item.IsApproved)
                                            {
                                                <form asp-action="ApproveComment" asp-route-id="@item.Id" method="post" class="d-inline m-0 mr-1">
                                                    <button type="submit" class="btn btn-outline-success btn-sm" title="Onayla">
                                                        <i class="fa fa-check mr-1"></i> Onayla
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="RejectComment" asp-route-id="@item.Id" method="post" class="d-inline m-0 mr-1">
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Yayından Kaldır">
                                                        <i class="fa fa-ban mr-1"></i> Askıya Al
                                                    </button>
                                                </form>
                                            }

                                            <button type="button" class="btn btn-outline-warning btn-sm mr-1" data-toggle="modal" data-target="#replyCommentModal-@item.Id" title="Yanıtla">
                                                <i class="fa fa-reply mr-1"></i> Yanıtla
                                            </button>

                                            <form asp-action="DeleteComment" asp-route-id="@item.Id" method="post" class="d-inline m-0" onsubmit="return confirm('Bu yorumu silmek istediğinize emin misiniz?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                    <i class="fa fa-trash mr-1"></i> Sil
                                                </button>
                                            </form>
                                        </div>

                                        <!-- Reply Modal -->
                                        <div class="modal fade text-left" id="replyCommentModal-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-dark text-white">
                                                        <h5 class="modal-title text-white">
                                                            <i class="fa fa-reply text-warning mr-2"></i> Yorumu Yanıtla
                                                        </h5>
                                                        <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                                    </div>
                                                    <form asp-action="ReplyComment" method="post">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <div class="modal-body">
                                                            <div class="p-3 bg-light rounded text-dark mb-3" style="white-space: pre-line; word-break: break-word;">
                                                                <small class="text-muted d-block font-weight-bold mb-1">Kullanıcı Yorumu (@item.Name):</small>
                                                                @item.Comment
                                                            </div>
                                                            <div class="form-group mb-2">
                                                                <label class="font-weight-bold text-dark">Yönetici Yanıtınız:</label>
                                                                <textarea name="replyText" class="form-control" rows="4" placeholder="Kullanıcıya yanıt metnini yazınız..." required>@item.AdminReply</textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Kapat</button>
                                                            <button type="submit" class="btn btn-warning btn-sm font-weight-bold">Yanıtı Kaydet</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Kayıtlı yorum bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
