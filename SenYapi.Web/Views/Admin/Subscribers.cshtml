@model IEnumerable<NewsletterSubscriber>
@{
    ViewData["Title"] = "E-Bülten Aboneleri";
}

@if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-check-circle mr-2"></i> @TempData["AdminSuccess"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="mb-0 font-weight-bold text-dark">
                <i class="fa fa-users text-info mr-2"></i> Kayıtlı E-Bülten Aboneleri (@Model.Count())
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th style="width: 80px;">#</th>
                            <th>E-Posta Adresi</th>
                            <th>Kayıt Tarihi</th>
                            <th class="text-right" style="width: 120px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int count = 1;
                            foreach (var sub in Model)
                            {
                                <tr>
                                    <td>@(count++)</td>
                                    <td>
                                        <i class="fa fa-envelope text-muted mr-2"></i>
                                        <a href="mailto:@sub.Email" class="font-weight-bold text-dark">@sub.Email</a>
                                    </td>
                                    <td>@sub.CreatedAt.ToString("dd MMMM yyyy HH:mm")</td>
                                    <td class="text-right">
                                        <form asp-controller="AdminMessages" asp-action="DeleteSubscriber" asp-route-id="@sub.Id" method="post" class="d-inline" onsubmit="return confirm('Bu aboneyi silmek istediğinize emin misiniz?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Aboneliği Sil">
                                                <i class="fa fa-trash mr-1"></i> Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Henüz kayıtlı bülten abonesi bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
