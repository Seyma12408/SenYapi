@model IEnumerable<ServiceItem>
@{
    ViewData["Title"] = "Hizmetler Yönetimi";
}

@if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-check-circle mr-2"></i> @TempData["AdminSuccess"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["AdminError"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="mb-0 font-weight-bold text-dark">
                <i class="fa fa-tools text-warning mr-2"></i> Faaliyet Alanları & Hizmetler (@Model.Count())
            </h5>
            <button type="button" class="btn btn-warning btn-sm font-weight-bold" data-toggle="modal" data-target="#addServiceModal">
                <i class="fa fa-plus-circle mr-1"></i> Yeni Hizmet Ekle
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th style="width: 100px;">Görsel</th>
                            <th>Hizmet Başlığı</th>
                            <th>Açıklama</th>
                            <th class="text-right" style="min-width: 210px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@Url.Content(item.ImageUrl)" alt="@item.Title" class="admin-img-16-9 shadow-sm" style="width: 72px;" />
                                    </td>
                                    <td class="font-weight-bold text-dark">@item.Title</td>
                                    <td>
                                        <small class="text-muted text-truncate d-block" style="max-width: 400px;">@item.Description</small>
                                    </td>
                                    <td class="text-right">
                                        <div class="d-inline-flex align-items-center">
                                            <button type="button" class="btn btn-outline-info btn-sm mr-1" data-toggle="modal" data-target="#serviceDetailModal-@item.Id" title="Ayrıntıları Göster">
                                                <i class="fa fa-eye mr-1"></i> Detay
                                            </button>
                                            <button type="button" class="btn btn-outline-warning btn-sm mr-1" data-toggle="modal" data-target="#serviceEditModal-@item.Id" title="Düzenle">
                                                <i class="fa fa-edit mr-1"></i> Düzenle
                                            </button>
                                            <form asp-controller="AdminManagement" asp-action="DeleteService" asp-route-id="@item.Id" method="post" class="d-inline m-0" onsubmit="return confirm('Bu hizmeti silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Hizmeti Sil">
                                                    <i class="fa fa-trash mr-1"></i> Sil
                                                </button>
                                            </form>
                                        </div>

                                        <!-- Service Detail Modal -->
                                        <div class="modal fade text-left" id="serviceDetailModal-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-dark text-white">
                                                        <h5 class="modal-title text-white">
                                                            <i class="fa fa-tools text-warning mr-2"></i> @item.Title
                                                        </h5>
                                                        <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="text-center mb-3">
                                                            <div class="admin-cover-preview-box mx-auto" style="max-width: 350px;">
                                                                <img src="@Url.Content(item.ImageUrl)" alt="@item.Title" />
                                                            </div>
                                                        </div>
                                                        <p><strong>Açıklama:</strong></p>
                                                        <div class="p-3 bg-light rounded text-dark">@item.Description</div>
                                                        <p class="mt-2 text-muted small"><strong>Görsel Yolu:</strong> <code>@item.ImageUrl</code></p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Kapat</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Service Edit Modal -->
                                        <div class="modal fade text-left" id="serviceEditModal-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-dark text-white">
                                                        <h5 class="modal-title text-white">
                                                            <i class="fa fa-edit text-warning mr-2"></i> Hizmeti Düzenle
                                                        </h5>
                                                        <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                                    </div>
                                                    <form asp-controller="AdminManagement" asp-action="UpdateService" method="post" enctype="multipart/form-data">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="Id" value="@item.Id" />
                                                        <div class="modal-body">
                                                            <div class="form-group mb-3">
                                                                <label class="font-weight-bold text-dark">Hizmet Başlığı *</label>
                                                                <input type="text" name="Title" class="form-control" value="@item.Title" required />
                                                            </div>
                                                            <div class="form-group mb-3">
                                                                <label class="font-weight-bold text-dark">Görsel Değiştir (Bilgisayardan Yükle)</label>
                                                                <div class="d-flex align-items-center mb-2">
                                                                    <div class="admin-cover-preview-box mr-3" style="width: 140px; aspect-ratio: 16 / 9;">
                                                                        <img id="editServicePreview-@item.Id" src="@Url.Content(item.ImageUrl)" alt="@item.Title" />
                                                                    </div>
                                                                    <div class="flex-grow-1">
                                                                        <input type="file" name="imageFile" class="form-control-file border p-1 rounded" accept="image/png,image/jpeg,image/webp,image/svg+xml" onchange="previewServiceEditImage(this, '@item.Id')" />
                                                                        <small class="text-muted d-block mt-1">16:9 oranında otomatik ölçeklenir.</small>
                                                                    </div>
                                                                </div>
                                                                <input type="hidden" name="ImageUrl" value="@item.ImageUrl" />
                                                            </div>
                                                            <div class="form-group mb-3">
                                                                <label class="font-weight-bold text-dark">Detaylı Açıklama *</label>
                                                                <textarea name="Description" class="form-control" rows="4" required>@item.Description</textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                                                            <button type="submit" class="btn btn-warning font-weight-bold">Değişiklikleri Kaydet</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Henüz kayıtlı hizmet bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title text-white">
                    <i class="fa fa-plus-circle text-warning mr-2"></i> Yeni Hizmet Ekle
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form asp-controller="AdminManagement" asp-action="AddService" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Hizmet Başlığı *</label>
                        <input type="text" name="Title" class="form-control" placeholder="Örn: Akıllı Ev Sistemleri" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Hizmet Görseli Yükle</label>
                        <div class="d-flex align-items-center mb-2">
                            <div class="admin-cover-preview-box mr-3 d-none" id="addServicePreviewBox" style="width: 140px; aspect-ratio: 16 / 9;">
                                <img id="addServicePreviewImg" src="#" alt="Önizleme" />
                            </div>
                            <div class="flex-grow-1">
                                <input type="file" name="imageFile" id="addServiceFileInput" class="form-control-file border p-1 rounded" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                                <small class="text-muted d-block mt-1">Maksimum 5MB (JPG, PNG, WEBP) - 16:9 oranında gösterilir</small>
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Detaylı Açıklama *</label>
                        <textarea name="Description" class="form-control" rows="4" placeholder="Hizmet detayları ve kapsamı..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning font-weight-bold">Kaydet ve Yayınla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewServiceEditImage(input, id) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#editServicePreview-' + id).attr('src', e.target.result);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        $(document).ready(function () {
            $('#addServiceFileInput').on('change', function () {
                if (this.files && this.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#addServicePreviewImg').attr('src', e.target.result);
                        $('#addServicePreviewBox').removeClass('d-none');
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });
        });
    </script>
}
