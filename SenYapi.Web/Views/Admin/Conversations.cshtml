@model IEnumerable<Conversation>
@{
    ViewData["Title"] = "Kullanıcı Mesajlaşmaları (Canlı Destek / Talepler)";
}

@if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle mr-1"></i> @TempData["AdminSuccess"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-wrap align-items-center justify-content-between">
            <h5 class="mb-0 font-weight-bold text-dark">
                <i class="fa fa-comments text-warning mr-2"></i> Kullanıcı Mesajlaşmaları (@Model.Count())
            </h5>
            <span class="badge badge-warning text-dark font-weight-bold px-3 py-2">
                Açık Konuşma: @Model.Count(c => c.IsOpen)
            </span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa fa-comment-slash fa-3x mb-3 text-warning"></i>
                    <p class="mb-0">Henüz başlatılmış bir kullanıcı konuşması bulunmuyor.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Konu</th>
                                <th>Kullanıcı</th>
                                <th>Mesaj Sayısı</th>
                                <th>Son Hareket</th>
                                <th>Durum</th>
                                <th class="text-right" style="width: 200px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td>@c.Id</td>
                                    <td>
                                        <div class="font-weight-bold text-dark">@c.Subject</div>
                                        @if (c.Messages != null && c.Messages.Any(m => !m.IsFromAdmin && !m.IsRead))
                                        {
                                            <span class="badge badge-danger">Yeni Okunmamış Mesaj</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="font-weight-bold">@(c.User?.FullName ?? c.User?.UserName ?? "Kullanıcı")</div>
                                        <div class="small text-muted"><i class="fa fa-envelope mr-1"></i> @(c.User?.Email)</div>
                                    </td>
                                    <td>
                                        <span class="badge badge-light border">@(c.Messages?.Count ?? 0) Mesaj</span>
                                    </td>
                                    <td>
                                        <span class="small text-muted">@c.LastMessageAt.ToString("dd.MM.yyyy HH:mm")</span>
                                    </td>
                                    <td>
                                        @if (c.IsOpen)
                                        {
                                            <span class="badge badge-success px-2 py-1">Açık</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary px-2 py-1">Kapatıldı</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <a asp-action="ConversationDetail" asp-route-id="@c.Id" class="btn btn-sm btn-warning font-weight-bold">
                                            <i class="fa fa-reply mr-1"></i> Mesajları Gör
                                        </a>
                                        @if (c.IsOpen)
                                        {
                                            <form asp-action="CloseConversation" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Bu konuşmayı kapatmak istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Konuşmayı Kapat">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

